    "The change history could not be saved. No system changes were made.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The change history could not be saved. No system changes were made."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存更改历史。未做任何系统更改。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar el historial de cambios. No se realizaron cambios en el sistema."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تاریخچه تغییرات ذخیره نشد. هیچ تغییری در سیستم انجام نشد."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更履歴を保存できませんでした。システムへの変更は行われていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 기록을 저장할 수 없습니다. 시스템 변경이 수행되지 않았습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить журнал изменений. Изменений в системе не было."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể lưu lịch sử thay đổi. Không có thay đổi hệ thống nào được thực hiện."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "無法保存更改歷史。未做任何系統更改。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存變更記錄。未做任何系統更改。"
          }
        }
      }
    },
