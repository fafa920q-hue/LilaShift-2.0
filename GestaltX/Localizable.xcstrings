    "These combinations belong to a different device.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These combinations belong to a different device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些组合属于另一台设备。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas combinaciones pertenecen a otro dispositivo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این ترکیب‌ها متعلق به دستگاه دیگری هستند."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの組み合わせは別のデバイスのものです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 조합은 다른 기기의 것입니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти комбинации принадлежат другому устройству."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các tổ hợp này thuộc về một thiết bị khác."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "這些組合屬於另一台裝置。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "這些組合屬於另一台裝置。"
          }
        }
      }
    },
    "These combinations use a newer format this version cannot read.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These combinations use a newer format this version cannot read."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些组合使用了此版本无法读取的新格式。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas combinaciones usan un formato más nuevo que esta versión no puede leer."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این ترکیب‌ها از قالب جدیدتری استفاده می‌کنند که این نسخه نمی‌تواند بخواند."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの組み合わせは、このバージョンでは読み取れない新しい形式を使用しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 조합은 이 버전에서 읽을 수 없는 새 형식을 사용합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти комбинации используют более новый формат, который эта версия не может прочитать."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các tổ hợp này dùng định dạng mới hơn mà phiên bản này không thể đọc."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "這些組合使用了此版本無法讀取的新格式。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "這些組合使用了此版本無法讀取的新格式。"
          }
        }
      }
    },
