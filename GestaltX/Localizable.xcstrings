    "Only fields that were re-read after a restart are claimed accepted. A value in the file does not prove the system uses it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only fields that were re-read after a restart are claimed accepted. A value in the file does not prove the system uses it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在重启后重新读取过的字段才会被声称为已接受。文件中的值并不能证明系统实际在使用它。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se declaran aceptados los campos releídos tras un reinicio. Un valor en el archivo no prueba que el sistema lo use."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط فیلدهایی که پس از راه‌اندازی مجدد دوباره خوانده شده‌اند، پذیرفته‌شده اعلام می‌شوند. مقدار موجود در فایل ثابت نمی‌کند که سیستم از آن استفاده می‌کند."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再起動後に再読み取りされたフィールドのみが承認されたものとして主張されます。ファイル内の値が、システムがそれを使用していることを証明するわけではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재시작 후 다시 읽은 필드만 수락된 것으로 주장됩니다. 파일의 값이 시스템이 해당 값을 사용한다는 것을 증명하지는 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Принятыми заявляются только поля, перечитанные после перезагрузки. Значение в файле не доказывает, что система его использует."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ các trường đã được đọc lại sau khi khởi động lại mới được coi là đã chấp nhận. Giá trị trong tệp không chứng minh hệ thống đang dùng nó."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在重新啟動後重新讀取過的欄位才會被聲稱為已接受。文件中的值並不能證明系統實際在使用它。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在重新啟動後重新讀取過的欄位才會被聲稱為已接受。檔案中的值並不能證明系統實際在使用它。"
          }
        }
      }
    },
