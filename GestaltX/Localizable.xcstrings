        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原生 AI iPhone 上个人翻译 CacheExtra 键明确为 0，但其原生 CacheData 槽位基线为 1。请先恢复 CacheExtra 键，再暂存。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave CacheExtra del Traductor personal es explícitamente 0 en un iPhone con IA nativa, pero la línea base de su ranura CacheData nativa es 1. Restaura la clave CacheExtra antes de preparar."
