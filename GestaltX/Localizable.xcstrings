    "Re-read the device after a restart and check what actually stuck.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Re-read the device after a restart and check what actually stuck."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重启后重新读取设备，检查实际生效了什么。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a leer el dispositivo tras un reinicio y comprueba qué se mantuvo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پس از راه‌اندازی مجدد، دستگاه را دوباره بخوانید و بررسی کنید چه چیزی واقعاً اعمال شده است."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再起動後にデバイスを再読み取りし、実際に何が残ったかを確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재시작 후 기기를 다시 읽고 실제로 무엇이 유지되었는지 확인합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После перезагрузки перечитайте устройство и проверьте, что действительно сохранилось."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đọc lại thiết bị sau khi khởi động lại và kiểm tra những gì thực sự còn hiệu lực."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "重新啟動後重新讀取設備，檢查實際生效了什麼。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "重新啟動後重新讀取裝置，檢查實際生效了什麼。"
          }
        }
      }
    },
    "Read the device first to analyze a proposal.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read the device first to analyze a proposal."
          }
        },
