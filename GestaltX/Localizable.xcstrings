    "A combination cannot contain the same preset twice.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A combination cannot contain the same preset twice."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个组合不能两次包含同一个预设。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una combinación no puede contener el mismo ajuste dos veces."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک ترکیب نمی‌تواند یک پیش‌تنظیم را دو بار داشته باشد."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "組み合わせに同じプリセットを2回含めることはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하나의 조합에 같은 프리셋을 두 번 포함할 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Комбинация не может содержать один и тот же пресет дважды."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một tổ hợp không thể chứa cùng một cài đặt sẵn hai lần."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "一個組合不能兩次包含同一個預設。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "一個組合不能兩次包含同一個預設。"
          }
        }
      }
    },
