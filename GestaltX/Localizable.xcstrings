    "Personalized recommendations for this device, generated locally from real readings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Personalized recommendations for this device, generated locally from real readings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "针对本机的个性化建议，根据真实读取数据在本地生成。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recomendaciones personalizadas para este dispositivo, generadas localmente a partir de lecturas reales."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "توصیه‌های شخصی‌سازی‌شده برای این دستگاه که به‌صورت محلی از خواندن‌های واقعی ساخته می‌شوند."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイス向けのパーソナライズされた推奨事項は、実際の読み取り値からローカルで生成されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에 대한 개인 맞춤형 권장 사항은 실제 측정값에서 로컬로 생성됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Персональные рекомендации для этого устройства, созданные локально на основе реальных показаний."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đề xuất cá nhân hóa cho thiết bị này, được tạo cục bộ từ dữ liệu đọc thực."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "針對本設備的個人化建議，依據真實讀取資料於本機產生。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
