    "Unrelated cache bytes changed — apply will be refused.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unrelated cache bytes changed — apply will be refused."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存在无关缓存字节更改，将拒绝应用。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiaron bytes de caché no relacionados; no se aplicará."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بایت‌های نامرتبط حافظه پنهان تغییر کردند — اعمال رد خواهد شد."
          }
        },
        "ja": {
