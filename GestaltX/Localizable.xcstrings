    "The device could not be identified, so its fingerprint was not saved.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device could not be identified, so its fingerprint was not saved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法识别设备，因此未保存其指纹。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo identificar el dispositivo, por lo que no se guardó su huella."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دستگاه قابل شناسایی نبود، بنابراین اثر انگشت آن ذخیره نشد."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスを識別できなかったため、そのフィンガープリントは保存されませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기를 식별할 수 없어 해당 지문이 저장되지 않았습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось определить устройство, поэтому его отпечаток не сохранён."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể xác định thiết bị nên vân tay của nó không được lưu."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "無法識別設備，因此未保存其指紋。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "無法識別裝置，因此未儲存其指紋。"
          }
        }
      }
    },
