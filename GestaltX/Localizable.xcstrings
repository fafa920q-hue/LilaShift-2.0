    "Restore this backup?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore this backup?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复这个备份？"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Restaurar este respaldo?"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این نسخهٔ پشتیبان بازیابی شود؟"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバックアップを復元しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 백업을 복원하시겠습니까?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановить эту резервную копию?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khôi phục bản sao lưu này?"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
