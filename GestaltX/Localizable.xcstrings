          }
        }
      }
    },
    "The settings backup could not be verified. No changes were applied.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The settings backup could not be verified. No changes were applied."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法验证设置备份，未应用任何更改。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo verificar la copia de los ajustes. No se aplicó ningún cambio."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پشتیبان تنظیمات تأیید نشد. هیچ تغییری اعمال نشد."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定のバックアップを検証できませんでした。変更は適用されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
