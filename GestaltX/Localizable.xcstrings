          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiết bị đã thay đổi — cần xác minh lại phạm vi hỗ trợ"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置已更改——支援範圍需要重新驗證"
