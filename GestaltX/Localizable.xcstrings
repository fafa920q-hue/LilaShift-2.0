    "Staged: the change is prepared for review, not yet written.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Staged: the change is prepared for review, not yet written."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已暂存：更改已准备好供审核，尚未写入。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparado: el cambio está listo para revisión, aún no se ha escrito."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مرحله‌بندی شد: تغییر برای بازبینی آماده است و هنوز نوشته نشده است."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステージング済み：変更は確認用に準備されており、まだ書き込まれていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스테이징됨: 변경 사항이 검토용으로 준비되었으며 아직 쓰지 않았습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подготовлено: изменение готово к проверке, ещё не записано."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã chuẩn bị: thay đổi đã sẵn sàng để xem xét, chưa được ghi."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "已暫存：變更已準備好供審核，尚未寫入。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "已暫存：變更已準備好供審核，尚未寫入。"
          }
        }
      }
    },
    "Staging flips the eSIM cache flags only. It does not prove eSIM hardware is present.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Staging flips the eSIM cache flags only. It does not prove eSIM hardware is present."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂存仅翻转 eSIM 缓存标志，不能证明存在 eSIM 硬件。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La preparación solo cambia los indicadores de caché de eSIM. No prueba que haya hardware eSIM."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مرحله‌بندی فقط پرچم‌های حافظه پنهان eSIM را تغییر می‌دهد. وجود سخت‌افزار eSIM را ثابت نمی‌کند."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステージングでは eSIM キャッシュフラグのみが切り替わります。eSIM ハードウェアの存在を証明するものではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스테이징은 eSIM 캐시 플래그만 바꿉니다. eSIM 하드웨어가 있음을 증명하지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подготовка меняет только флаги кэша eSIM. Это не доказывает наличие оборудования eSIM."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuẩn bị chỉ lật các cờ bộ nhớ đệm eSIM. Điều đó không chứng minh có phần cứng eSIM."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "暫存僅翻轉 eSIM 快取旗標，不能證明存在 eSIM 硬件。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "暫存僅翻轉 eSIM 快取旗標，不能證明存在 eSIM 硬體。"
          }
        }
      }
    },
