          }
        }
      }
    },
    "Device identity or build changed since the last fingerprint.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device identity or build changed since the last fingerprint."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自上次记录指纹以来，设备标识或构建已更改。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La identidad o la compilación del dispositivo cambió desde la última huella."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هویت یا بیلد دستگاه از زمان آخرین اثر انگشت تغییر کرده است."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回のフィンガープリント取得以降、デバイスの識別情報またはビルドが変更されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막 지문 기록 이후 기기 식별 정보 또는 빌드가 변경되었습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Идентификатор или сборка устройства изменились с момента последнего отпечатка."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Định danh hoặc bản dựng của thiết bị đã thay đổi kể từ lần ghi vân tay trước."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "自上次記錄指紋以來，裝置識別或版本已更改。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "自上次記錄指紋以來，裝置識別或版本已更改。"
          }
        }
      }
    },
