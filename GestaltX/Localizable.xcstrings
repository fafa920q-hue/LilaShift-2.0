          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "شش قابلیت Apple Intelligence را فعال کنید، از جمله ترجمه، پاک‌سازی عکس و Hey Siri همیشه‌شنوا."
          }
        },
        "ja": {
