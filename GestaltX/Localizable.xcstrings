            "state": "translated",
            "value": "기기를 다시 읽고 그때 무결성 검사가 통과하는지 확인하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прочитайте устройство ещё раз и проверьте, пройдут ли тогда проверки целостности."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy đọc lại thiết bị và kiểm tra xem khi đó các bước kiểm tra tính toàn vẹn có đạt không."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請重新讀取裝置，查看屆時完整性檢查是否通過。"
