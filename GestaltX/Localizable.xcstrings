    "Search, filter and save presets — from the catalog only.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search, filter and save presets — from the catalog only."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索、筛选并收藏预设——仅基于预设库。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca, filtra y guarda ajustes, solo desde el catálogo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیش‌تنظیم‌ها را جستجو، فیلتر و ذخیره کنید — فقط از فهرست."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プリセットを検索、絞り込み、保存——カタログからのみ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프리셋을 검색하고 필터링하며 저장하세요 — 카탈로그에서만."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ищите, фильтруйте и сохраняйте пресеты — только из каталога."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm kiếm, lọc và lưu cài đặt sẵn — chỉ từ danh mục."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "搜尋、篩選並收藏預設——僅基於預設庫。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "搜尋、篩選並收藏預設——僅基於預設庫。"
          }
        }
      }
    },
