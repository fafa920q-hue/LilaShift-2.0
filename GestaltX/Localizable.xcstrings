    "The CacheData slot cannot be repaired to a known baseline on this device, so staging is refused until the recorded original value is available.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The CacheData slot cannot be repaired to a known baseline on this device, so staging is refused until the recorded original value is available."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备上的 CacheData 槽位无法修复到已知的基线，因此在获得已记录的原值之前拒绝暂存。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ranura de CacheData no se puede reparar a un valor base conocido en este dispositivo, así que la preparación se rechaza hasta que el valor original registrado esté disponible."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "شکاف CacheData در این دستگاه را نمی‌توان به مقدار پایه شناخته‌شده بازگرداند، بنابراین تا زمانی که مقدار اصلی ثبت‌شده در دسترس نباشد، مرحله‌بندی رد می‌شود."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスの CacheData スロットは既知の基準値に修復できないため、記録された元の値が利用可能になるまでステージングは拒否されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기의 CacheData 슬롯을 알려진 기준값으로 복구할 수 없어 기록된 원래 값을 사용할 수 있을 때까지 스테이징이 거부됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слот CacheData на этом устройстве нельзя восстановить до известного базового уровня, поэтому подготовка отклоняется до появления записанного исходного значения."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể sửa khe CacheData về giá trị gốc đã biết trên thiết bị này nên việc chuẩn bị bị từ chối cho đến khi có giá trị gốc đã ghi."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "此設備上的 CacheData 槽位無法修復至已知的基線，因此在取得已記錄的原始值之前拒絕暫存。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "此裝置上的 CacheData 槽位無法修復至已知的基線，因此在取得已記錄的原始值之前拒絕暫存。"
          }
        }
      }
    },
    "The backup could not be verified. No system changes were made.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The backup could not be verified. No system changes were made."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法验证备份，未做任何系统更改。"
