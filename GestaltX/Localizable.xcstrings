          }
        }
      }
    },
    "Do not restore from this backup. Create a fresh backup, and keep the failed file for inspection.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not restore from this backup. Create a fresh backup, and keep the failed file for inspection."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请勿从此备份恢复。请创建一个新的备份，并保留失败的文件以供检查。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No restaures desde esta copia de seguridad. Crea una copia nueva y conserva el archivo fallido para revisarlo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "از این پشتیبان بازیابی نکنید. یک پشتیبان تازه بسازید و فایل ناموفق را برای بررسی نگه دارید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバックアップからは復元しないでください。新しいバックアップを作成し、失敗したファイルは確認用に保管してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 백업에서 복원하지 마십시오. 새 백업을 만들고 실패한 파일은 검사용으로 보관하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не восстанавливайтесь из этой резервной копии. Создайте новую копию, а неудавшийся файл сохраните для проверки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đừng khôi phục từ bản sao lưu này. Hãy tạo bản sao lưu mới và giữ lại tệp lỗi để kiểm tra."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請勿從此備份還原。請建立一個新的備份，並保留失敗的檔案以供檢查。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "請勿從此備份還原。請建立一個新的備份，並保留失敗的檔案以供檢查。"
          }
        }
      }
    },
    "Do not retry the write blindly. Re-read the device to see its current state first.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not retry the write blindly. Re-read the device to see its current state first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请勿盲目重试写入。请先重新读取设备，查看其当前状态。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No reintentes la escritura a ciegas. Vuelve a leer el dispositivo para ver su estado actual primero."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نوشتن را کورکورانه دوباره امتحان نکنید. اول دستگاه را دوباره بخوانید تا وضعیت فعلی آن را ببینید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き込みをむやみに再試行しないでください。まずデバイスを再度読み取り、現在の状態を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쓰기를 무작정 다시 시도하지 마십시오. 먼저 기기를 다시 읽어 현재 상태를 확인하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не повторяйте запись вслепую. Сначала прочитайте устройство ещё раз, чтобы увидеть его текущее состояние."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đừng thử ghi lại một cách mù quáng. Hãy đọc lại thiết bị trước để xem trạng thái hiện tại của nó."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請勿盲目重試寫入。請先重新讀取裝置，查看其目前狀態。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "請勿盲目重試寫入。請先重新讀取裝置，查看其目前狀態。"
          }
        }
      }
    },
