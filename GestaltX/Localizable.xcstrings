          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có thể cần khởi động lại thiết bị. Vẫn cần phần cứng hỗ trợ."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
