    "Cache, compatibility, backup and modification risk, from real readings only.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache, compatibility, backup and modification risk, from real readings only."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缓存、兼容性、备份与修改风险，均来自真实读取。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Caché, compatibilidad, copia de seguridad y riesgo de modificación, solo a partir de lecturas reales."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کش، سازگاری، پشتیبان و خطر تغییر، فقط از خواندن‌های واقعی."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャッシュ、互換性、バックアップ、変更リスクを、実際の読み取り値のみから評価します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캐시, 호환성, 백업 및 수정 위험을 실제 읽기 값으로만 평가합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кэш, совместимость, резервная копия и риск изменений — только по реальным показаниям."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ nhớ đệm, khả năng tương thích, sao lưu và rủi ro sửa đổi, chỉ từ các lần đọc thực."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "緩存、兼容性、備份與修改風險，均來自真實讀取。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "快取、相容性、備份與修改風險，均來自真實讀取。"
          }
        }
      }
    },
    "Dependencies, conflicts and duplicates for a proposal, before you stage it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dependencies, conflicts and duplicates for a proposal, before you stage it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在暂存之前，先查看该方案的依赖、冲突与重复修改。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dependencias, conflictos y duplicados de una propuesta, antes de prepararla."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "وابستگی‌ها، تداخل‌ها و موارد تکراری یک پیشنهاد، پیش از آماده‌سازی آن."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステージする前に、提案の依存関係、競合、重複を確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "준비하기 전에 제안의 종속성, 충돌 및 중복을 확인합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зависимости, конфликты и дубликаты предложения — до подготовки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các phụ thuộc, xung đột và trùng lặp của một đề xuất, trước khi bạn chuẩn bị nó."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "在暫存之前，先查看該方案的依賴、衝突與重複修改。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "在暫存之前，先查看該方案的依賴、衝突與重複修改。"
          }
        }
      }
    },
