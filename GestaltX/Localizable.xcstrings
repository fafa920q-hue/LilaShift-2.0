    "Device values changed between the stored fingerprint and the current read.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device values changed between the stored fingerprint and the current read."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在已存储的指纹与当前读取之间，设备值发生了变化。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los valores del dispositivo cambiaron entre la huella guardada y la lectura actual."
          }
        },
        "fa": {
