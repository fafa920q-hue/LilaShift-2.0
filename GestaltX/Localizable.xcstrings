    "LilaShift is independent software. It is not affiliated with Apple or the credited projects.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LilaShift is independent software. It is not affiliated with Apple or the credited projects."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "紫序 是独立软件，与 Apple 及鸣谢项目没有隶属关系。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "LilaShift es un software independiente. No está afiliado a Apple ni a los proyectos reconocidos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "LilaShift نرم‌افزاری مستقل است و به Apple یا پروژه‌های ذکرشده وابسته نیست."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LilaShiftは独立したソフトウェアです。Appleやクレジットに記載されたプロジェクトとは関係ありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "LilaShift는 개인이 개발한 독립 소프트웨어입니다. Apple 공식 소프트웨어가 아니며, 크레딧에 명시된 다른 오픈소스 프로젝트들과도 직접적인 제휴 관계가 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "LilaShift — независимое ПО, не связанное с Apple или указанными проектами."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "LilaShift là phần mềm độc lập, không liên kết với Apple hoặc các dự án được ghi công."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "LilaShift 是獨立軟件，與 Apple 及鳴謝項目沒有隸屬關係。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
