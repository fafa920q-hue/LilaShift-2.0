    "Some settings could not be restored automatically. Read them again and use Revert.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some settings could not be restored automatically. Read them again and use Revert."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分设置未能自动恢复，请重新读取并使用“还原”。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos ajustes no se restauraron automáticamente. Vuelve a leerlos y usa Restaurar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برخی تنظیمات خودکار بازگردانده نشدند. آن‌ها را دوباره بخوانید و از بازگردانی استفاده کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部の設定を自動で元に戻せませんでした。再読み込みしてから「元に戻す」を使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 설정을 자동으로 복원하지 못했습니다. 다시 읽은 후 복원을 사용하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Некоторые настройки не удалось восстановить автоматически. Прочитайте их заново и нажмите «Восстановить»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một số cài đặt không thể tự động khôi phục. Đọc lại và chọn Khôi phục."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "部分設定未能自動恢復，請重新讀取並使用「還原」。"
          }
        },
        "zh-Hant-TW": {
