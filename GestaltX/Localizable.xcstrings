            "state": "translated",
            "value": "ریسک تغییر نیاز به توجه دارد"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更リスクに注意が必要です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수정 위험에 주의가 필요합니다"
          }
        },
        "ru": {
          "stringUnit": {
