    },
    "The cache layout could not be resolved on this model and OS build, so eSIM staging was refused by the guard.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The cache layout could not be resolved on this model and OS build, so eSIM staging was refused by the guard."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此机型和系统构建上无法解析缓存布局，因此防护机制拒绝了 eSIM 暂存。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo resolver el diseño de la caché en este modelo y compilación del SO, por lo que el guardián rechazó la preparación de la eSIM."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "چیدمان کش روی این مدل و بیلد سیستم‌عامل قابل حل نبود، پس محافظ از آماده‌سازی eSIM جلوگیری کرد."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このモデルと OS ビルドではキャッシュレイアウトを解決できなかったため、ガードが eSIM のステージングを拒否しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 모델 및 OS 빌드에서 캐시 레이아웃을 확인할 수 없어 가드가 eSIM 스테이징을 거부했습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Раскладку кэша не удалось разрешить на этой модели и сборке ОС, поэтому защита отклонила подготовку eSIM."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể xác định bố cục bộ nhớ đệm trên mẫu máy và bản dựng hệ điều hành này, vì vậy bộ phận bảo vệ đã từ chối chuẩn bị eSIM."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "在此型號和系統版本上無法解析快取佈局，因此防護機制拒絕了 eSIM 暫存。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "在此型號和系統版本上無法解析快取佈局，因此防護機制拒絕了 eSIM 暫存。"
          }
        }
      }
    },
    "The eSIM cache layout could not be resolved on this device.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The eSIM cache layout could not be resolved on this device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法解析此设备上的 eSIM 缓存布局。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo resolver el diseño de caché de la eSIM en este dispositivo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "چیدمان کش eSIM روی این دستگاه قابل حل نبود."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスの eSIM キャッシュレイアウトを解決できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 eSIM 캐시 레이아웃을 확인할 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось разрешить раскладку кэша eSIM на этом устройстве."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể xác định bố cục bộ nhớ đệm eSIM trên thiết bị này."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "無法解析此裝置上的 eSIM 快取佈局。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "無法解析此裝置上的 eSIM 快取佈局。"
          }
        }
      }
    },
    "The file failed its byte-count, digest or plist check.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file failed its byte-count, digest or plist check."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该文件未通过字节数、摘要或 plist 检查。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo no pasó la comprobación de tamaño, resumen ni plist."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فایل بررسی تعداد بایت، خلاصه یا plist را پشت سر نگذاشت."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルはバイト数、ダイジェスト、または plist のチェックに失敗しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일은 바이트 수, 다이제스트 또는 plist 검사를 통과하지 못했습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл не прошёл проверку размера, дайджеста или plist."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp đã không đạt kiểm tra số byte, mã băm hoặc plist."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "該檔案未通過位元組數、摘要或 plist 檢查。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "該檔案未通過位元組數、摘要或 plist 檢查。"
          }
        }
      }
    },
    "The file holds the staged value, but the live system returns a different answer. A value in the file does not prove the system uses it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file holds the staged value, but the live system returns a different answer. A value in the file does not prove the system uses it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件保存的是暂存值，但实时系统返回了不同的答案。文件中有某个值，并不能证明系统正在使用它。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo contiene el valor preparado, pero el sistema en vivo devuelve otra respuesta. Que un valor esté en el archivo no prueba que el sistema lo use."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فایل مقدار آماده‌شده را دارد، اما سیستم زنده پاسخ متفاوتی برمی‌گرداند. وجود یک مقدار در فایل ثابت نمی‌کند که سیستم از آن استفاده می‌کند."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルにはステージングされた値がありますが、ライブシステムは異なる答えを返します。ファイルに値があることは、システムがそれを使用している証明にはなりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일에는 스테이징된 값이 있지만 실시간 시스템은 다른 답을 반환합니다. 파일에 값이 있다고 해서 시스템이 그 값을 사용한다는 증거는 아닙니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В файле находится подготовленное значение, но живая система возвращает другой ответ. Наличие значения в файле не доказывает, что система его использует."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp chứa giá trị đã chuẩn bị, nhưng hệ thống trực tiếp trả về đáp án khác. Việc một giá trị có trong tệp không chứng minh hệ thống đang dùng nó."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案保存的是暫存值，但即時系統返回了不同的答案。檔案中有某個值，並不能證明系統正在使用它。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案保存的是暫存值，但即時系統返回了不同的答案。檔案中有某個值，並不能證明系統正在使用它。"
          }
        }
      }
    },
    "The live probe did not answer for these keys: acceptance is based on the file value only.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The live probe did not answer for these keys: acceptance is based on the file value only."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实时检测未回答这些键：验收仅基于文件值。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sonda en vivo no respondió para estas claves: la aceptación se basa solo en el valor del archivo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کاوش زنده برای این کلیدها پاسخی نداد: پذیرش فقط بر اساس مقدار فایل است."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブプローブはこれらのキーに回答しませんでした。受け入れはファイルの値のみに基づきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실시간 프로브가 이 키들에 답하지 않았습니다. 수락은 파일 값에만 근거합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Живой зонд не ответил для этих ключей: приёмка основана только на значении файла."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đầu dò trực tiếp đã không trả lời cho các khóa này: việc chấp nhận chỉ dựa trên giá trị tệp."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "即時偵測未回答這些鍵：驗收僅基於檔案值。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "即時偵測未回答這些鍵：驗收僅基於檔案值。"
          }
        }
      }
    },
    "The live system answer disagrees with the file value.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The live system answer disagrees with the file value."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实时系统的答案与文件值不一致。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La respuesta del sistema en vivo no coincide con el valor del archivo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پاسخ سیستم زنده با مقدار فایل مطابقت ندارد."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブシステムの答えがファイルの値と一致しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실시간 시스템 답이 파일 값과 일치하지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ответ живой системы не совпадает со значением файла."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đáp án của hệ thống trực tiếp không khớp với giá trị tệp."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "即時系統的答案與檔案值不一致。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "即時系統的答案與檔案值不一致。"
          }
        }
      }
    },
    "The modification-risk checks did not all pass.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The modification-risk checks did not all pass."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修改风险检查并未全部通过。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No todas las comprobaciones de riesgo de modificación pasaron."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همه بررسی‌های ریسک تغییر موفق نبودند."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更リスクチェックがすべて通過したわけではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수정 위험 검사가 모두 통과하지는 못했습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не все проверки риска изменений пройдены."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không phải mọi bước kiểm tra rủi ro sửa đổi đều đạt."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "修改風險檢查並未全部通過。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "修改風險檢查並未全部通過。"
          }
        }
      }
    },
    "The product type, OS build, cache layout or slot count changed since the fingerprint was captured, so the previously recorded support scope may no longer apply.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The product type, OS build, cache layout or slot count changed since the fingerprint was captured, so the previously recorded support scope may no longer apply."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自记录指纹以来，产品类型、系统构建、缓存布局或插槽数量已更改，因此此前记录的支持范围可能不再适用。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tipo de producto, la compilación del SO, el diseño de la caché o el número de ranuras cambió desde que se capturó la huella, por lo que el alcance de compatibilidad registrado anteriormente podría ya no aplicarse."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نوع محصول، بیلد سیستم‌عامل، چیدمان کش یا تعداد شکاف‌ها از زمان ثبت اثر انگشت تغییر کرده‌اند، پس محدوده پشتیبانی ثبت‌شده قبلی ممکن است دیگر اعمال نشود."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィンガープリント取得以降、製品タイプ、OS ビルド、キャッシュレイアウト、またはスロット数が変更されたため、以前に記録されたサポート範囲が適用されなくなっている可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지문을 기록한 이후 제품 유형, OS 빌드, 캐시 레이아웃 또는 슬롯 수가 변경되어 이전에 기록된 지원 범위가 더 이상 적용되지 않을 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тип продукта, сборка ОС, раскладка кэша или количество слотов изменились с момента снятия отпечатка, поэтому ранее записанная область поддержки может больше не применяться."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Loại sản phẩm, bản dựng hệ điều hành, bố cục bộ nhớ đệm hoặc số khe đã thay đổi kể từ khi vân tay được ghi lại, vì vậy phạm vi hỗ trợ đã ghi trước đây có thể không còn áp dụng."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "自記錄指紋以來，產品類型、系統版本、快取佈局或插槽數量已更改，因此此前記錄的支援範圍可能不再適用。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "自記錄指紋以來，產品類型、系統版本、快取佈局或插槽數量已更改，因此此前記錄的支援範圍可能不再適用。"
          }
        }
      }
    },
    "The proposal touched a hardware-identity field. Staging it is refused by design: changing such a field can break Face ID or make the system discard the whole cache at boot.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The proposal touched a hardware-identity field. Staging it is refused by design: changing such a field can break Face ID or make the system discard the whole cache at boot."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该方案触及了硬件标识字段。按设计会拒绝暂存：更改此类字段可能破坏面容 ID，或导致系统在启动时丢弃整个缓存。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La propuesta tocaba un campo de identidad de hardware. Prepararla se rechaza por diseño: cambiar ese campo puede romper Face ID o hacer que el sistema descarte toda la caché al arrancar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیشنهاد به یک فیلد هویت سخت‌افزاری برخورد کرد. آماده‌سازی آن به‌صورت طراحی‌شده رد می‌شود: تغییر چنین فیلدی می‌تواند Face ID را خراب کند یا باعث شود سیستم کل کش را هنگام راه‌اندازی دور بریزد."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "提案がハードウェア識別情報のフィールドに触れました。ステージングは設計上拒否されます。そのようなフィールドを変更すると Face ID が壊れたり、起動時にシステムがキャッシュ全体を破棄したりする可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제안이 하드웨어 식별 정보 필드에 닿았습니다. 스테이징은 설계상 거부됩니다. 이러한 필드를 변경하면 Face ID가 손상되거나 부팅 시 시스템이 전체 캐시를 버릴 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предложение затрагивало поле аппаратного идентификатора. Подготовка отклоняется по замыслу: изменение такого поля может сломать Face ID или заставить систему отбросить весь кэш при загрузке."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đề xuất đã chạm vào một trường định danh phần cứng. Việc chuẩn bị bị từ chối theo thiết kế: thay đổi trường như vậy có thể làm hỏng Face ID hoặc khiến hệ thống loại bỏ toàn bộ bộ nhớ đệm khi khởi động."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "該方案觸及了硬件識別欄位。按設計會拒絕暫存：更改此類欄位可能破壞面容 ID，或導致系統在啟動時丟棄整個快取。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "該方案觸及了硬體識別欄位。按設計會拒絕暫存：更改此類欄位可能破壞 Face ID，或導致系統在啟動時丟棄整個快取。"
          }
        }
      }
    },
    "The region code is back to its original value in the re-read document.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The region code is back to its original value in the re-read document."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在重新读取的文稿中，地区代码已恢复为原值。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El código de región ha vuelto a su valor original en el documento releído."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در سند بازخوانی‌شده، کد منطقه به مقدار اصلی خود برگشته است."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再読み込みしたドキュメントでは、地域コードが元の値に戻っています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 읽은 문서에서 지역 코드가 원래 값으로 돌아갔습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В повторно прочитанном документе код региона вернулся к исходному значению."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong tài liệu đọc lại, mã vùng đã trở về giá trị gốc của nó."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "在重新讀取的文件中，地區代碼已恢復為原值。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "在重新讀取的文件中，地區代碼已恢復為原值。"
          }
        }
      }
    },
    "The system rebuilt the cached region value on restart instead of keeping the staged value. This has been observed on iPhone 17 Pro Max (A3527): the region returned to CH after a restart.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system rebuilt the cached region value on restart instead of keeping the staged value. This has been observed on iPhone 17 Pro Max (A3527): the region returned to CH after a restart."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统在重新启动时重建了缓存的地区值，而没有保留暂存值。这一情况已在 iPhone 17 Pro Max（A3527）上观察到：重新启动后地区恢复为 CH。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sistema reconstruyó el valor de región almacenado al reiniciar en lugar de conservar el valor preparado. Esto se ha observado en el iPhone 17 Pro Max (A3527): la región volvió a CH tras reiniciar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سیستم هنگام راه‌اندازی مجدد، مقدار منطقه ذخیره‌شده را بازسازی کرد به‌جای اینکه مقدار آماده‌شده را نگه دارد. این موضوع روی iPhone 17 Pro Max (A3527) مشاهده شده است: منطقه پس از راه‌اندازی مجدد به CH برگشت."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムは再起動時にステージングされた値を保持するのではなく、キャッシュされた地域値を再構築しました。これは iPhone 17 Pro Max（A3527）で観測されています。再起動後、地域は CH に戻りました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템은 다시 시작할 때 스테이징된 값을 유지하는 대신 캐시된 지역 값을 다시 만들었습니다. 이는 iPhone 17 Pro Max(A3527)에서 관찰되었습니다. 다시 시작한 후 지역이 CH로 돌아갔습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При перезапуске система пересоздала кэшированное значение региона вместо того, чтобы сохранить подготовленное значение. Это наблюдалось на iPhone 17 Pro Max (A3527): после перезапуска регион вернулся к CH."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hệ thống đã tái tạo giá trị vùng đã lưu trong bộ nhớ đệm khi khởi động lại thay vì giữ giá trị đã chuẩn bị. Điều này đã được quan sát trên iPhone 17 Pro Max (A3527): vùng đã trở về CH sau khi khởi động lại."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "系統在重新啟動時重建了快取的地區值，而沒有保留暫存值。這一情況已在 iPhone 17 Pro Max（A3527）上觀察到：重新啟動後地區恢復為 CH。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "系統在重新啟動時重建了快取的地區值，而沒有保留暫存值。這一情況已在 iPhone 17 Pro Max（A3527）上觀察到：重新啟動後地區恢復為 CH。"
          }
        }
      }
    },
    "Try reading again. If it keeps failing, check the App Group and signing state.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try reading again. If it keeps failing, check the App Group and signing state."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请重试读取。如果仍然失败，请检查 App Group 和签名状态。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Intenta leer de nuevo. Si sigue fallando, comprueba el App Group y el estado de firma."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دوباره خواندن را امتحان کنید. اگر همچنان ناموفق بود، App Group و وضعیت امضا را بررسی کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再度読み取ってみてください。引き続き失敗する場合は、App Group と署名の状態を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 읽어 보십시오. 계속 실패하면 App Group 및 서명 상태를 확인하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попробуйте прочитать ещё раз. Если это снова не удастся, проверьте App Group и состояние подписи."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy thử đọc lại. Nếu vẫn thất bại, hãy kiểm tra App Group và trạng thái ký."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請重試讀取。如果仍然失敗，請檢查 App Group 和簽名狀態。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "請重試讀取。如果仍然失敗，請檢查 App Group 和簽名狀態。"
          }
        }
      }
    },
