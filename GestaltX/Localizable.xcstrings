    "Remove Added Fields": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove Added Fields"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除新增字段"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar campos agregados"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "حذف فیلدهای افزوده‌شده"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加フィールドを削除"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추가된 필드 제거"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить добавленные поля"
          }
        },
        "vi": {
          "stringUnit": {
