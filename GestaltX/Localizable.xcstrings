          }
        }
      }
    },
    "A device restart may be required. Layout behavior varies by device.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A device restart may be required. Layout behavior varies by device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可能需要重新启动设备才能生效。布局效果因设备而异。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es posible que se requiera reiniciar el dispositivo. El diseño varía según el dispositivo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ممکن است راه‌اندازی مجدد دستگاه لازم باشد. رفتار چیدمان به دستگاه بستگی دارد."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスの再起動が必要になる場合があります。レイアウトの動作はデバイスによって異なります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 재시동이 필요할 수 있습니다. 화면 레이아웃 동작 방식은 기기에 따라 다르게 나타납니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Может потребоваться перезагрузка устройства. Поведение макета зависит от устройства."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có thể cần khởi động lại thiết bị. Bố cục thay đổi theo thiết bị."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "可能需要重新啓動設備才能生效。佈局效果因設備而異。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "可能需要重新啟動裝置才能生效。佈局效果因裝置而異。"
          }
        }
      }
    },
    "Restart required. Siri uses a device-specific capability type; changing it may affect the Apple Intelligence Siri interface. Keep the current value or restore the recorded original.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restart required. Siri uses a device-specific capability type; changing it may affect the Apple Intelligence Siri interface. Keep the current value or restore the recorded original."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要重新启动设备。Siri 使用机型相关的能力类型，修改此类型可能影响 Apple 智能 Siri 界面，请保持当前值或还原已记录的原始值。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinicio requerido. Siri usa un tipo de capacidad específico del dispositivo; cambiarlo puede afectar a la interfaz de Siri de Apple Intelligence. Mantén el valor actual o restaura el original registrado."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "راه‌اندازی مجدد لازم است. Siri از نوع قابلیتی ویژهٔ دستگاه استفاده می‌کند؛ تغییر آن ممکن است بر رابط Siri در Apple Intelligence تأثیر بگذارد. مقدار فعلی را حفظ کنید یا مقدار اصلی ثبت‌شده را بازگردانید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再起動が必要です。Siriはデバイス固有の機能タイプを使用します。変更するとApple IntelligenceのSiriインターフェースに影響する可能性があります。現在の値を維持するか、記録済みの元の値を復元してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재시동이 필요합니다. Siri는 기기별 기능 유형을 사용합니다. 이를 변경하면 Apple Intelligence Siri 인터페이스에 영향을 줄 수 있습니다. 현재 값을 유지하거나 기록된 원래 값으로 복원하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Требуется перезагрузка. Siri использует тип возможностей, зависящий от устройства; его изменение может повлиять на интерфейс Siri в Apple Intelligence. Сохраните текущее значение или восстановите записанное исходное."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần khởi động lại. Siri sử dụng loại khả năng riêng cho từng thiết bị; thay đổi giá trị này có thể ảnh hưởng đến giao diện Siri của Apple Intelligence. Hãy giữ giá trị hiện tại hoặc khôi phục giá trị gốc đã lưu."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "需要重新啓動設備。Siri 使用機型相關的能力類型，修改此類型可能影響 Apple 智能 Siri 介面，請保持目前值或還原已記錄的原始值。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "需要重新啟動裝置。Siri 使用機型相關的能力類型，修改此類型可能影響 Apple 智慧 Siri 介面，請保持目前值或還原已記錄的原始值。"
          }
        }
      }
    },
    "Restart required. Apple Intelligence also depends on device and region. Results depend on the app and system support.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restart required. Apple Intelligence also depends on device and region. Results depend on the app and system support."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要重新启动设备。Apple 智能还取决于机型与地区。效果取决于 App 和系统支持。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinicio requerido. Apple Intelligence también depende del dispositivo y de la región. Los resultados dependen de la app y del soporte del sistema."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "راه‌اندازی مجدد لازم است. Apple Intelligence به دستگاه و منطقه نیز بستگی دارد. نتیجه به برنامه و پشتیبانی سیستم بستگی دارد."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再起動が必要です。Apple Intelligenceはデバイスと地域にも依存します。結果はアプリとシステムの対応状況によって異なります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재시동이 필요합니다. Apple Intelligence는 기기 모델 및 지역 제한의 영향을 받습니다. 결과는 앱과 시스템 지원 여부에 따라 달라집니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Требуется перезагрузка. Доступность Apple Intelligence также зависит от устройства и региона. Результат зависит от приложения и поддержки системы."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần khởi động lại. Apple Intelligence còn tùy thuộc vào thiết bị và vùng. Kết quả tùy thuộc vào ứng dụng và mức hỗ trợ của hệ thống."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "需要重新啓動設備。Apple 智能還取決於機型與地區。效果取決於 App 與系統支援。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "需要重新啟動裝置。Apple 智慧還取決於機型與地區。效果取決於 App 與系統支援。"
          }
        }
      }
    },
    "A device restart may be required. Some system services may behave differently.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A device restart may be required. Some system services may behave differently."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可能需要重新启动设备才能生效。部分系统服务的行为可能发生变化。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es posible que se requiera reiniciar el dispositivo. Algunos servicios del sistema podrían comportarse de manera diferente."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ممکن است راه‌اندازی مجدد دستگاه لازم باشد. ممکن است برخی خدمات سیستم رفتار متفاوتی داشته باشند."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスの再起動が必要になる場合があります。一部のシステムサービスの動作が変わる可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 재시동이 필요할 수 있습니다. 일부 시스템 서비스의 동작이 달라질 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Может потребоваться перезагрузка устройства. Некоторые системные службы могут работать иначе."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có thể cần khởi động lại thiết bị. Một số dịch vụ hệ thống có thể hoạt động khác đi."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "可能需要重新啓動設備才能生效。部分系統服務的行為可能發生變化。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "可能需要重新啟動裝置才能生效。部分系統服務的行為可能發生變化。"
          }
        }
      }
    },
    "A device restart may be required. This changes the system-wide InternalBuild flag, not just storage information. System services may behave differently. Revert restores the recorded original value.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A device restart may be required. This changes the system-wide InternalBuild flag, not just storage information. System services may behave differently. Revert restores the recorded original value."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可能需要重新启动设备才能生效。此操作修改系统全局的 InternalBuild 标记，并非仅调整存储信息。系统服务的行为可能发生变化。“还原”会恢复已记录的原始值。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es posible que se requiera reiniciar el dispositivo. Esto modifica el indicador InternalBuild de todo el sistema, no solo la información de almacenamiento. Los servicios del sistema pueden comportarse de forma diferente. Revertir restaura el valor original registrado."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ممکن است راه‌اندازی مجدد دستگاه لازم باشد. این کار پرچم سراسری InternalBuild را تغییر می‌دهد، نه فقط اطلاعات فضای ذخیره‌سازی را. رفتار سرویس‌های سیستم ممکن است تغییر کند. بازگردانی، مقدار اصلی ثبت‌شده را بازیابی می‌کند."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスの再起動が必要になる場合があります。ストレージ情報だけでなく、システム全体のInternalBuildフラグを変更します。システムサービスの動作が変わる可能性があります。「元に戻す」で記録済みの元の値を復元します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 재시동이 필요할 수 있습니다. 저장 공간 정보뿐 아니라 시스템 전체의 InternalBuild 플래그를 변경합니다. 시스템 서비스의 동작이 달라질 수 있습니다. 되돌리면 기록된 원래 값이 복원됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Может потребоваться перезагрузка устройства. Это изменяет системный флаг InternalBuild, а не только сведения о хранилище. Поведение системных служб может измениться. Возврат восстанавливает записанное исходное значение."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có thể cần khởi động lại thiết bị. Thao tác này thay đổi cờ InternalBuild trên toàn hệ thống, không chỉ thông tin bộ nhớ. Hoạt động của các dịch vụ hệ thống có thể thay đổi. Hoàn nguyên sẽ khôi phục giá trị gốc đã ghi lại."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "可能需要重新啓動設備才能生效。此操作會修改系統全域的 InternalBuild 標記，並非只調整儲存空間資訊。系統服務的行為可能改變。「還原」會恢復已記錄的原始值。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "可能需要重新啟動裝置才能生效。此操作會修改系統全域的 InternalBuild 旗標，並非僅調整儲存空間資訊。系統服務的行為可能改變。「還原」會恢復已記錄的原始值。"
          }
        }
      }
    },
    "A device restart may be required. This does not turn the device into an Apple SRD.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A device restart may be required. This does not turn the device into an Apple SRD."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可能需要重新启动设备才能生效。此操作不会将设备变成 Apple 官方安全研究设备。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es posible que se requiera reiniciar el dispositivo. Esto no convierte el dispositivo en un Apple SRD."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ممکن است راه‌اندازی مجدد دستگاه لازم باشد. این کار دستگاه را به یک Apple SRD واقعی تبدیل نمی‌کند."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスの再起動が必要になる場合があります。デバイスがApple SRDになるわけではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 재시동이 필요할 수 있습니다. 설정한다고 해서 일반 기기가 실제 Apple 보안 리서치 기기로 변환되지는 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Может потребоваться перезагрузка устройства. Это не превращает устройство в официальное Apple SRD."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có thể cần khởi động lại thiết bị. Thao tác này không biến thiết bị thành Apple SRD."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "可能需要重新啓動設備才能生效。此操作不會將設備變成 Apple 官方安全研究設備。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "可能需要重新啟動裝置才能生效。此操作不會將裝置變成 Apple 官方安全研究裝置。"
          }
        }
      }
    },
