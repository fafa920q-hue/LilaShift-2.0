    "Audio Intelligence CacheData slot #%d reads 1, but its native baseline is 0. Repair the slot to 0 before staging Audio Intelligence.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio Intelligence CacheData slot #%d reads 1, but its native baseline is 0. Repair the slot to 0 before staging Audio Intelligence."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频智能 CacheData 槽位 #%d 读数为 1，但其原生基线为 0。请先将槽位修复为 0，再暂存音频智能。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ranura CacheData #%d de Inteligencia de audio lee 1, pero su línea base nativa es 0. Repara la ranura a 0 antes de preparar Inteligencia de audio."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "شیار CacheData #%d هوش صوتی مقدار 1 را می‌خواند، اما مقدار پایه بومی آن 0 است. پیش از آماده‌سازی هوش صوتی، شیار را به 0 برگردانید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オーディオインテリジェンス CacheData スロット #%d の読み取り値が 1 ですが、ネイティブのベースラインは 0 です。オーディオインテリジェンスをステージングする前に、スロットを 0 に修復してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오 인텔리전스 CacheData 슬롯 #%d의 읽은 값이 1이지만 네이티브 기준값은 0입니다. 오디오 인텔리전스를 스테이징하기 전에 슬롯을 0으로 복구하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слот CacheData #%d аудиоинтеллекта показывает 1, но его базовое значение — 0. Восстановите слот на 0 перед подготовкой аудиоинтеллекта."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khe CacheData #%d của Trí tuệ âm thanh đọc được 1 nhưng giá trị gốc của nó là 0. Hãy sửa khe về 0 trước khi chuẩn bị Trí tuệ âm thanh."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "音訊智慧 CacheData 插槽 #%d 讀數為 1，但其原生基線為 0。請先將插槽修復為 0，再暫存音訊智慧。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "音訊智慧 CacheData 插槽 #%d 讀數為 1，但其原生基線為 0。請先將插槽修復為 0，再暫存音訊智慧。"
