    "The deletion is staged. The device file changes only after you apply.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The deletion is staged. The device file changes only after you apply."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除操作会先暂存，应用后才会修改设备文件。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La eliminación queda en espera. El archivo del dispositivo solo cambiará tras aplicar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "حذف موقتاً ثبت می‌شود. فایل دستگاه فقط پس از اعمال تغییر می‌کند."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除は保留されます。デバイスのファイルは適用後にのみ変更されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제 대기 상태입니다. 기기 시스템 파일은 '변경 사항 적용'을 누른 후에만 변경됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаление отложено. Файл на устройстве изменится только после применения."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc xóa được tạm lưu. Tệp trên thiết bị chỉ thay đổi sau khi bạn áp dụng."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除操作會先暫存，應用後才會修改設備文件。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除操作會先暫存，應用後才會修改裝置檔案。"
          }
        }
      }
    },
