          }
        }
      }
    },
    "No action is needed unless the change was unexpected — then review the change history.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No action is needed unless the change was unexpected — then review the change history."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "除非该更改出乎意料，否则无需采取行动——如有意外，请查看更改历史。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hace falta hacer nada, salvo que el cambio fuera inesperado; en ese caso, revisa el historial de cambios."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هیچ اقدامی لازم نیست، مگر اینکه تغییر غیرمنتظره بوده باشد — در آن صورت سابقه تغییرات را بررسی کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更が予期しないものでない限り、対応は不要です。予期しない場合は変更履歴を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경이 예상치 못한 것이 아니라면 조치가 필요 없습니다. 예상치 못한 경우 변경 기록을 검토하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего делать не нужно, если изменение не было неожиданным; в противном случае просмотрите историю изменений."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không cần hành động gì trừ khi thay đổi đó là bất ngờ — trong trường hợp đó, hãy xem lại lịch sử thay đổi."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "除非該更改出乎意料，否則無需採取行動——如有意外，請查看更改歷史。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "除非該更改出乎意料，否則無需採取行動——如有意外，請查看更改歷史。"
          }
        }
      }
    },
