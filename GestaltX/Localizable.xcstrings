    "What went wrong, why, and what to try — from real readings only.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What went wrong, why, and what to try — from real readings only."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出了什么问题、为什么、以及可以尝试什么——仅基于真实读取。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué salió mal, por qué y qué probar, solo a partir de lecturas reales."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "چه چیزی اشتباه شد، چرا، و چه چیزی را امتحان کنید — فقط از خواندن‌های واقعی."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何が問題だったのか、なぜなのか、何を試すべきか — 実際の読み取り結果のみから。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무엇이 잘못되었는지, 왜 그런지, 무엇을 시도할지 — 실제 읽기 결과만으로."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что пошло не так, почему и что попробовать — только по реальным показаниям."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã xảy ra lỗi gì, tại sao và nên thử gì — chỉ từ các lần đọc thực tế."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "出了甚麼問題、為甚麼、以及可以嘗試甚麼——僅基於真實讀取。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "出了什麼問題、為什麼、以及可以嘗試什麼——僅基於真實讀取。"
          }
        }
      }
    },
