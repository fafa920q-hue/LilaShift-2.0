    "eSIM settings are unavailable. You can still configure region and AI under Intelligence.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "eSIM settings are unavailable. You can still configure region and AI under Intelligence."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取 eSIM 配置。仍可在“Apple 智能与地区”中单独设置地区代码和 AI。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ajustes de eSIM no están disponibles. Puedes configurar la región y la IA por separado en Inteligencia."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تنظیمات eSIM در دسترس نیست. همچنان می‌توانید منطقه و هوش مصنوعی را جداگانه در بخش هوشمندی تنظیم کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "eSIM 設定を読み取れません。「インテリジェンス」から地域と AI を個別に設定できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "eSIM 설정을 읽을 수 없습니다. 인텔리전스에서 지역과 AI를 개별적으로 설정할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройки eSIM недоступны. Регион и ИИ можно настроить отдельно в разделе интеллектуальных функций."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không đọc được cài đặt eSIM. Bạn vẫn có thể cấu hình vùng và AI riêng trong mục Trí tuệ."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取 eSIM 設定。仍可在「智能」中個別設定地區和 AI。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取 eSIM 設定。仍可在「智慧功能」中個別設定地區和 AI。"
          }
        }
      }
    },
