          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Значения устройства изменились между сохранённым отпечатком и текущим чтением."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các giá trị thiết bị đã thay đổi giữa vân tay đã lưu và lần đọc hiện tại."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
