          }
        }
      }
    },
    "Re-read the device. If it keeps failing, note the model and iOS minor version — the layout may not be resolvable on this build.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Re-read the device. If it keeps failing, note the model and iOS minor version — the layout may not be resolvable on this build."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请重新读取设备。如果仍然失败，请记下机型和 iOS 小版本号——此构建上的布局可能无法解析。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a leer el dispositivo. Si sigue fallando, anota el modelo y la versión secundaria de iOS: es posible que el diseño no se pueda resolver en esta compilación."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دستگاه را دوباره بخوانید. اگر همچنان ناموفق بود، مدل و نسخه فرعی iOS را یادداشت کنید — ممکن است چیدمان در این بیلد قابل حل نباشد."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスを再度読み取ってください。引き続き失敗する場合は、モデルと iOS のマイナーバージョンを記録してください。このビルドではレイアウトを解決できない場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기를 다시 읽으십시오. 계속 실패하면 모델과 iOS 부 버전을 기록하십시오. 이 빌드에서는 레이아웃을 확인할 수 없을 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прочитайте устройство ещё раз. Если это снова не удастся, запишите модель и минорную версию iOS: возможно, раскладку нельзя разрешить на этой сборке."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy đọc lại thiết bị. Nếu vẫn thất bại, hãy ghi lại mẫu máy và phiên bản phụ của iOS — bố cục có thể không xác định được trên bản dựng này."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請重新讀取裝置。如果仍然失敗，請記下型號和 iOS 小版本號——此版本上的佈局可能無法解析。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "請重新讀取裝置。如果仍然失敗，請記下型號和 iOS 小版本號——此版本上的佈局可能無法解析。"
          }
        }
      }
    },
    "Re-verify support on this build before staging anything.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Re-verify support on this build before staging anything."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在暂存任何内容之前，请在此构建上重新验证支持情况。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a verificar la compatibilidad en esta compilación antes de preparar nada."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیش از آماده‌سازی هر چیزی، پشتیبانی را روی همین بیلد دوباره تأیید کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何かをステージングする前に、このビルドでのサポートを再確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무엇이든 스테이징하기 전에 이 빌드에서 지원을 다시 확인하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторно проверьте поддержку на этой сборке, прежде чем что-либо подготавливать."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy xác minh lại khả năng hỗ trợ trên bản dựng này trước khi chuẩn bị bất cứ thứ gì."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "在暫存任何內容之前，請在此版本上重新驗證支援情況。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "在暫存任何內容之前，請在此版本上重新驗證支援情況。"
          }
        }
      }
    },
