    "Review the changes, apply them, then restart the device.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review the changes, apply them, then restart the device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先查看并应用更改，然后重启设备。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa y aplica los cambios y después reinicia el dispositivo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تغییرات را بررسی و اعمال کنید، سپس دستگاه را دوباره راه‌اندازی کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更を確認して適用し、デバイスを再起動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 사항을 검토하고 적용한 다음 기기를 재시동합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте и примените изменения, затем перезагрузите устройство."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem lại và áp dụng thay đổi rồi khởi động lại thiết bị."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "先檢查並套用更改，然後重新啟動裝置。"
          }
        },
        "zh-Hant-TW": {
