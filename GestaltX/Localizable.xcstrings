    "Some features are already natively supported or configured and need no change.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some features are already natively supported or configured and need no change."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分功能已获得原生支持或已配置，无需更改。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunas funciones ya son compatibles de forma nativa o ya están configuradas y no necesitan cambios."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برخی ویژگی‌ها از قبل به‌صورت بومی پشتیبانی می‌شوند یا پیکربندی شده‌اند و نیازی به تغییر ندارند."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部の機能はすでにネイティブでサポートされているか設定済みのため、変更は不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 기능은 이미 네이티브로 지원되거나 구성되어 있어 변경이 필요 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Некоторые функции уже поддерживаются встроенно или настроены и не требуют изменений."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một số tính năng đã được hỗ trợ gốc hoặc đã cấu hình nên không cần thay đổi."
          }
        },
        "zh-Hant-HK": {
