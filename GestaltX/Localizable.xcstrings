    "After applying, restart, then check the related entries in system Settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After applying, restart, then check the related entries in system Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用后请重启设备，再到系统“设置”查看相关入口。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de aplicar, reinicia el dispositivo y revisa las entradas relacionadas en Ajustes del sistema."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پس از اعمال، دستگاه را راه‌اندازی مجدد کنید و سپس ورودی‌های مرتبط را در تنظیمات سیستم بررسی کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "適用後、デバイスを再起動し、システム設定で関連項目を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "적용한 뒤 기기를 다시 시작하고 시스템 설정에서 관련 항목을 확인하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После применения перезагрузите устройство и проверьте связанные пункты в системных настройках."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sau khi áp dụng, hãy khởi động lại thiết bị rồi kiểm tra các mục liên quan trong Cài đặt hệ thống."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "套用後請重新啟動裝置，再到系統「設定」查看相關項目。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "套用後請重新啟動裝置，再到系統「設定」查看相關項目。"
          }
        }
      }
