        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ranura del Traductor personal está desactivada en un iPhone con IA nativa; Limpieza de Fotos y Siri de la cámara podrían fallar."
          }
        },
        "fa": {
          "stringUnit": {
