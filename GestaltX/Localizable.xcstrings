          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Может потребоваться перезагрузка устройства. Физическая кнопка не добавляется."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có thể cần khởi động lại thiết bị. Thao tác này không bổ sung nút vật lý."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "可能需要重新啓動設備才能生效。此操作不會為設備增加實體按鈕。"
