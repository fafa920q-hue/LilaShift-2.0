    "Stop the wallpaper from moving with device motion.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop the wallpaper from moving with device motion."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止壁纸随设备移动产生位移。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita que el fondo de pantalla se mueva con el movimiento del dispositivo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "از حرکت پس‌زمینه همراه با حرکت دستگاه جلوگیری می‌کند."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスの動きに合わせて壁紙が動くのを止めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기를 기울이거나 움직일 때 배경화면이 입체적으로 따라 움직이는 시차 효과를 정지시킵니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Останавливает движение обоев при движении устройства."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngăn hình nền di chuyển theo chuyển động của thiết bị."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "停止桌布隨裝置移動產生位移。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "停止桌布隨裝置移動產生位移。"
          }
        }
      }
    },
