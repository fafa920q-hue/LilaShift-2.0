        }
      }
    },
    "Audio Intelligence CacheData slot did not resolve, so its native baseline cannot be verified. Auto-staging is refused until the slot is verified on-device.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio Intelligence CacheData slot did not resolve, so its native baseline cannot be verified. Auto-staging is refused until the slot is verified on-device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频智能 CacheData 槽位未能解析，无法验证其原生基线。在真机上验证槽位之前，拒绝自动暂存。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo resolver la ranura CacheData de Inteligencia de audio, por lo que no se puede verificar su línea base nativa. Se rechaza la preparación automática hasta que la ranura se verifique en el dispositivo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "شیار CacheData هوش صوتی مشخص نشد، بنابراین مقدار پایه بومی آن قابل تأیید نیست. تا زمانی که شیار روی دستگاه تأیید شود، آماده‌سازی خودکار رد می‌شود."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オーディオインテリジェンス CacheData スロットを解決できなかったため、ネイティブのベースラインを確認できません。デバイス上でスロットが検証されるまで、自動ステージングは拒否されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오 인텔리전스 CacheData 슬롯을 확인할 수 없어 네이티브 기준값을 검증할 수 없습니다. 기기에서 슬롯이 확인될 때까지 자동 스테이징이 거부됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слот CacheData аудиоинтеллекта не определён, поэтому его базовое значение проверить нельзя. Автоматическая подготовка отклонена, пока слот не будет проверен на устройстве."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không xác định được khe CacheData của Trí tuệ âm thanh nên không thể xác minh giá trị gốc của nó. Từ chối tự động chuẩn bị cho đến khi khe được xác minh trên thiết bị."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "音訊智慧 CacheData 插槽未能解析，無法驗證其原生基線。在裝置上驗證插槽之前，拒絕自動暫存。"
          }
        },
