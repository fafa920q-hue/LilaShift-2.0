    "This restores every field in the backup, not just one change.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This restores every field in the backup, not just one change."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将恢复备份中的所有字段，而不仅是一项更改。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto restaura todos los campos de la copia de seguridad, no solo un cambio."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این همه فیلدهای پشتیبان را بازیابی می‌کند، نه فقط یک تغییر."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これによりバックアップ内のすべてのフィールドが復元され、1 つの変更だけではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업의 모든 필드를 복원하며, 하나의 변경만이 아닙니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это восстанавливает все поля из резервной копии, а не только одно изменение."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này khôi phục mọi trường trong bản sao lưu, không chỉ một thay đổi."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "這將還原備份中的所有欄位，而不僅是一項變更。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "這將還原備份中的所有欄位，而不僅是一項變更。"
          }
        }
      }
    },
