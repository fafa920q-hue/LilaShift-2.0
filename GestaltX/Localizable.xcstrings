    "Re-read consistent after restart: the value survived a device restart.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Re-read consistent after restart: the value survived a device restart."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重启后重读一致：该值在设备重启后仍保持。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Relectura coherente tras el reinicio: el valor sobrevivió al reinicio del dispositivo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بازخوانی پس از راه‌اندازی مجدد یکسان است: مقدار پس از راه‌اندازی مجدد دستگاه باقی مانده است."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再起動後の再読み取りが一致：この値はデバイスの再起動後も保持されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재시작 후 다시 읽기 일치: 이 값은 기기 재시작 후에도 유지되었습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторное чтение после перезагрузки совпадает: значение сохранилось после перезагрузки устройства."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đọc lại nhất quán sau khi khởi động lại: giá trị vẫn giữ sau khi khởi động lại thiết bị."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "重新啟動後重讀一致：該值在設備重新啟動後仍保持。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "重新啟動後重讀一致：該值在裝置重新啟動後仍保持。"
          }
        }
      }
    },
    "Read the device first to see personalized recommendations.": {
