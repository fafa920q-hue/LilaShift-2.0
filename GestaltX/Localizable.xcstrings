    "Restores the whole device file from this backup (%@).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restores the whole device file from this backup (%@)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将从此备份（%@）恢复整个设备文件。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura todo el archivo del dispositivo desde esta copia de seguridad (%@)."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کل فایل دستگاه را از این پشتیبان (%@) بازیابی می‌کند."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバックアップ（%@）からデバイスファイル全体を復元します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 백업(%@)에서 기기 파일 전체를 복원합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстанавливает весь файл устройства из этой резервной копии (%@)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khôi phục toàn bộ tệp thiết bị từ bản sao lưu này (%@)."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "將從此備份（%@）還原整個設備文件。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "將從此備份（%@）還原整個裝置檔案。"
          }
        }
      }
    },
    "Restoring only one of the eSIM pair leaves the flags inconsistent. Restore both together.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restoring only one of the eSIM pair leaves the flags inconsistent. Restore both together."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅恢复 eSIM 两个标志中的一个会导致标志不一致。请一起恢复。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurar solo uno de los dos indicadores eSIM los deja inconsistentes. Restaura ambos juntos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بازیابی فقط یکی از جفت پرچم‌های eSIM باعث ناسازگاری پرچم‌ها می‌شود. هر دو را با هم بازیابی کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "eSIM ペアの片方だけを復元するとフラグが不整合になります。両方一緒に復元してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "eSIM 쌍 중 하나만 복원하면 플래그가 일치하지 않게 됩니다. 둘을 함께 복원하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановление только одного из пары флагов eSIM оставит их несогласованными. Восстанавливайте оба вместе."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ khôi phục một trong hai cờ eSIM sẽ khiến các cờ không nhất quán. Hãy khôi phục cả hai cùng nhau."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "僅還原 eSIM 兩個旗標中的一個會導致旗標不一致。請一起還原。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "僅還原 eSIM 兩個旗標中的一個會導致旗標不一致。請一起還原。"
          }
        }
      }
    },
    "Restoring only the region code leaves the sales-region suffix inconsistent. Restore both together.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restoring only the region code leaves the sales-region suffix inconsistent. Restore both together."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅恢复地区代码会导致销售地区后缀不一致。请一起恢复。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurar solo el código de región deja inconsistente el sufijo de región de ventas. Restaura ambos juntos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بازیابی فقط کد منطقه باعث ناسازگاری پسوند منطقه فروش می‌شود. هر دو را با هم بازیابی کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地域コードだけを復元すると販売地域サフィックスが不整合になります。両方一緒に復元してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지역 코드만 복원하면 판매 지역 접미사가 일치하지 않게 됩니다. 둘을 함께 복원하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановление только кода региона оставит суффикс региона продаж несогласованным. Восстанавливайте оба вместе."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ khôi phục mã vùng sẽ khiến hậu tố vùng bán hàng không nhất quán. Hãy khôi phục cả hai cùng nhau."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "僅還原地區代碼會導致銷售地區後綴不一致。請一起還原。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "僅還原地區代碼會導致銷售地區後綴不一致。請一起還原。"
          }
        }
      }
    },
