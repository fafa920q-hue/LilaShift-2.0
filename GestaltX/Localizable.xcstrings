    "Personal Translator slot is off on a native-AI iPhone — Photos Clean Up and Camera Siri may fail.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Personal Translator slot is off on a native-AI iPhone — Photos Clean Up and Camera Siri may fail."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "个人翻译槽位在原生 Apple 智能 iPhone 上处于关闭状态，照片消除与相机 Siri 可能失效。"
          }
