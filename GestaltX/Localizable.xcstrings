            "value": "Это избранное использует более новый формат, который эта версия не может прочитать."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các mục yêu thích này dùng định dạng mới hơn mà phiên bản này không thể đọc."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "這些收藏使用了此版本無法讀取的新格式。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "這些收藏使用了此版本無法讀取的新格式。"
          }
        }
      }
    },
    "This combination is a plan only. It is not connected to staging or applying.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This combination is a plan only. It is not connected to staging or applying."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此组合仅为计划，未连接暂存或套用。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta combinación es solo un plan. No está conectada a la preparación ni a la aplicación."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این ترکیب فقط یک طرح است. به مرحله‌بندی یا اعمال متصل نیست."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この組み合わせは計画のみです。ステージングや適用には接続されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 조합은 계획일 뿐입니다. 스테이징이나 적용에 연결되어 있지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта комбинация — только план. Она не связана с подготовкой или применением."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tổ hợp này chỉ là kế hoạch. Nó không được kết nối với việc chuẩn bị hay áp dụng."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "此組合僅為計劃，未連接暫存或套用。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "此組合僅為計劃，未連接暫存或套用。"
          }
        }
      }
    },
