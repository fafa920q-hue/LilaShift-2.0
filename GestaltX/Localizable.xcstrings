    "Restore staged through the existing path. Apply and restart to verify.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore staged through the existing path. Apply and restart to verify."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已通过现有路径暂存恢复。请应用并重启以验证。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restauración preparada a través de la ruta existente. Aplica y reinicia para verificar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بازیابی از مسیر موجود مرحله‌بندی شد. اعمال کنید و برای تأیید راه‌اندازی مجدد کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既存のパスで復元がステージングされました。適用して再起動し、確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기존 경로를 통해 복원이 스테이징되었습니다. 적용하고 재시작하여 확인하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановление подготовлено через существующий путь. Примените и перезагрузите для проверки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khôi phục đã được chuẩn bị qua đường hiện có. Hãy áp dụng và khởi động lại để xác minh."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "已透過現有路徑暫存還原。請套用並重新啟動以驗證。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "已透過現有路徑暫存還原。請套用並重新啟動以驗證。"
          }
        }
      }
    },
    "Restore staged. Apply it, then restart and re-read to verify.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore staged. Apply it, then restart and re-read to verify."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复已暂存。请应用，然后重启并重新读取以验证。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restauración preparada. Aplícala, luego reinicia y vuelve a leer para verificar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بازیابی مرحله‌بندی شد. آن را اعمال کنید، سپس راه‌اندازی مجدد کرده و دوباره بخوانید تا تأیید شود."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復元がステージングされました。適用し、再起動して再読み取りを行い、確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복원이 스테이징되었습니다. 적용한 후 재시작하고 다시 읽어 확인하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановление подготовлено. Примените его, затем перезагрузите и прочитайте повторно для проверки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khôi phục đã được chuẩn bị. Hãy áp dụng, sau đó khởi động lại và đọc lại để xác minh."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "還原已暫存。請套用，然後重新啟動並重新讀取以驗證。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "還原已暫存。請套用，然後重新啟動並重新讀取以驗證。"
          }
        }
      }
    },
