          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các trường có giá trị hiện tại khác với giá trị gốc đã ghi."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "當前值與已記錄原始值不同的欄位。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "當前值與已記錄原始值不同的欄位。"
          }
        }
      }
    },
    "Read the device first to see modified values.": {
      "localizations": {
        "en": {
