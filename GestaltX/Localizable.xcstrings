    "Region code reads back as %@ — this verifies the staged code, not region-restricted services.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Region code reads back as %@ — this verifies the staged code, not region-restricted services."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地区代码回读值为 %@——这仅验证暂存的代码，不验证受地区限制的服务。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El código de región se lee como %@; esto verifica el código preparado, no los servicios restringidos por región."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کد منطقه به‌صورت %@ خوانده می‌شود — این فقط کد آماده‌شده را تأیید می‌کند، نه سرویس‌های محدود به منطقه را."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地域コードは %@ として読み戻されました。これはステージングしたコードを検証するもので、地域制限のあるサービスを検証するものではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지역 코드가 %@ (으)로 다시 읽혔습니다. 이는 스테이징한 코드를 확인하는 것이지 지역 제한 서비스를 확인하는 것이 아닙니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Код региона читается как %@ — это проверяет подготовленный код, а не службы с региональными ограничениями."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mã vùng đọc lại là %@ — điều này chỉ xác minh mã đã chuẩn bị, không phải dịch vụ bị giới hạn theo vùng."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "地區代碼回讀值為 %@——這僅驗證暫存的代碼，不驗證受地區限制的服務。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "地區代碼回讀值為 %@——這僅驗證暫存的代碼，不驗證受地區限制的服務。"
          }
        }
      }
    },
