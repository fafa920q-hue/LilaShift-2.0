        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "چیدمان حافظه پنهان از کتابخانه خود دستگاه به دست می‌آید و هرگز بر اساس مدل یا سیستم‌عامل حدس زده نمی‌شود."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャッシュレイアウトはデバイス自身のライブラリから解決され、機種や OS で推測されることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캐시 레이아웃은 기기 자체 라이브러리에서 확인되며, 모델이나 OS로 추측하지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Раскладка кэша определяется из собственной библиотеки устройства и никогда не выбирается по модели или ОС."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bố cục bộ nhớ đệm được xác định từ thư viện của chính thiết bị, không bao giờ suy đoán theo mẫu máy hay hệ điều hành."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "快取佈局取自設備自身的系統程式庫，絕不依機型或系統版本推測。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "快取佈局取自裝置自身的系統程式庫，絕不依機型或系統版本推測。"
          }
        }
      }
    },
    "CacheData slot #%d reads back at its native baseline — this verifies the slot value, not the feature itself.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CacheData slot #%d reads back at its native baseline — this verifies the slot value, not the feature itself."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CacheData 槽位 #%d 回读值为原生基线——这仅验证槽位值，不验证功能本身。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ranura #%d de CacheData se lee en su valor base nativo; esto verifica el valor de la ranura, no la función en sí."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "شکاف #%d از CacheData در مقدار پایه بومی خود خوانده می‌شود — این فقط مقدار شکاف را تأیید می‌کند، نه خود ویژگی را."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CacheData スロット #%d はネイティブの基準値で読み戻されました。これはスロットの値を検証するもので、機能自体を検証するものではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CacheData 슬롯 #%d이(가) 기본 기준값으로 다시 읽혔습니다. 이는 슬롯 값을 확인하는 것이지 기능 자체를 확인하는 것이 아닙니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слот #%d CacheData читается на исходном базовом уровне — это проверяет значение слота, а не саму функцию."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khe #%d của CacheData đọc lại đúng giá trị gốc — điều này chỉ xác minh giá trị khe, không phải tính năng."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "CacheData 槽位 #%d 回讀值為原生基線——這僅驗證槽位值，不驗證功能本身。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "CacheData 槽位 #%d 回讀值為原生基線——這僅驗證槽位值，不驗證功能本身。"
          }
        }
      }
    },
    "CacheData slots #%d/#%d read back as staged — this verifies the flags, not eSIM hardware.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CacheData slots #%d/#%d read back as staged — this verifies the flags, not eSIM hardware."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CacheData 槽位 #%d/#%d 回读值与暂存一致——这仅验证标志位，不验证 eSIM 硬件。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las ranuras #%d/#%d de CacheData se leen como se prepararon; esto verifica los indicadores, no el hardware eSIM."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "شکاف‌های #%d/#%d از CacheData همان‌طور که آماده شده بودند خوانده می‌شوند — این فقط پرچم‌ها را تأیید می‌کند، نه سخت‌افزار eSIM را."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CacheData スロット #%d/#%d はステージングした通りに読み戻されました。これはフラグを検証するもので、eSIM ハードウェアを検証するものではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CacheData 슬롯 #%d/#%d이(가) 스테이징한 대로 다시 읽혔습니다. 이는 플래그를 확인하는 것이지 eSIM 하드웨어를 확인하는 것이 아닙니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слоты #%d/#%d CacheData читаются как подготовленные — это проверяет флаги, а не оборудование eSIM."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các khe #%d/#%d của CacheData đọc lại đúng như đã chuẩn bị — điều này chỉ xác minh các cờ, không phải phần cứng eSIM."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "CacheData 槽位 #%d/#%d 回讀值與暫存一致——這僅驗證旗標，不驗證 eSIM 硬件。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "CacheData 槽位 #%d/#%d 回讀值與暫存一致——這僅驗證旗標，不驗證 eSIM 硬體。"
          }
        }
      }
    },
    "CacheExtra key %@ reads back as staged — this verifies the staged flag, not the underlying hardware or service.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CacheExtra key %@ reads back as staged — this verifies the staged flag, not the underlying hardware or service."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CacheExtra 键 %@ 回读值与暂存一致——这仅验证暂存的标志位，不验证底层硬件或服务。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave %@ de CacheExtra se lee como se preparó; esto verifica el indicador preparado, no el hardware o servicio subyacente."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کلید %@ از CacheExtra همان‌طور که آماده شده بود خوانده می‌شود — این فقط پرچم آماده‌شده را تأیید می‌کند، نه سخت‌افزار یا سرویس زیرین را."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CacheExtra キー %@ はステージングした通りに読み戻されました。これはステージングしたフラグを検証するもので、基盤のハードウェアやサービスを検証するものではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CacheExtra 키 %@이(가) 스테이징한 대로 다시 읽혔습니다. 이는 스테이징한 플래그를 확인하는 것이지 기본 하드웨어나 서비스를 확인하는 것이 아닙니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ %@ CacheExtra читается как подготовленный — это проверяет подготовленный флаг, а не базовое оборудование или службу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khóa %@ của CacheExtra đọc lại đúng như đã chuẩn bị — điều này chỉ xác minh cờ đã chuẩn bị, không phải phần cứng hay dịch vụ bên dưới."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "CacheExtra 鍵 %@ 回讀值與暫存一致——這僅驗證暫存的旗標，不驗證底層硬件或服務。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "CacheExtra 鍵 %@ 回讀值與暫存一致——這僅驗證暫存的旗標，不驗證底層硬體或服務。"
          }
        }
      }
    },
