    "The combinations could not be read. No system changes were made.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The combinations could not be read. No system changes were made."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取组合。未做任何系统更改。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron leer las combinaciones. No se realizaron cambios en el sistema."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ترکیب‌ها خوانده نشدند. هیچ تغییری در سیستم انجام نشد."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "組み合わせを読み取れませんでした。システムの変更は行われていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조합을 읽을 수 없습니다. 시스템 변경은 수행되지 않았습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать комбинации. Изменений в системе не внесено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể đọc các tổ hợp. Không có thay đổi hệ thống nào được thực hiện."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取組合。未做任何系統更改。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取組合。未做任何系統更改。"
          }
        }
      }
    },
    "The combinations could not be saved and verified. No system changes were made.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The combinations could not be saved and verified. No system changes were made."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存并验证组合。未做任何系统更改。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron guardar y verificar las combinaciones. No se realizaron cambios en el sistema."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ترکیب‌ها ذخیره و تأیید نشدند. هیچ تغییری در سیستم انجام نشد."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "組み合わせを保存・検証できませんでした。システムの変更は行われていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조합을 저장하고 확인할 수 없습니다. 시스템 변경은 수행되지 않았습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить и проверить комбинации. Изменений в системе не внесено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể lưu và xác minh các tổ hợp. Không có thay đổi hệ thống nào được thực hiện."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存並驗證組合。未做任何系統更改。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存並驗證組合。未做任何系統更改。"
          }
        }
      }
    },
