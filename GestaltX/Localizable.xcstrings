          }
        }
      }
    },
    "No recorded originals. Whether anything was modified cannot be determined.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No recorded originals. Whether anything was modified cannot be determined."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有已记录的原始值，无法判断是否修改过。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay originales registrados. No se puede determinar si algo se modificó."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مقدار اصلی ثبت‌شده‌ای وجود ندارد. نمی‌توان تعیین کرد چیزی تغییر کرده است یا نه."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録された元の値がありません。何が変更されたか判断できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록된 원래 값이 없습니다. 무엇이 수정되었는지 확인할 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет записанных исходных значений. Невозможно определить, было ли что-то изменено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có giá trị gốc đã ghi. Không thể xác định có gì đã bị sửa đổi."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有已記錄的原始值，無法判斷是否修改過。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有已記錄的原始值，無法判斷是否修改過。"
          }
        }
      }
    },
