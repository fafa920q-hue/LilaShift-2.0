          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این هر دو پرچم eSIM را با هم بازیابی می‌کند."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これにより両方の eSIM フラグが一緒に復元されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
