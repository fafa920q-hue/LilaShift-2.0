    "Enable six Apple Intelligence features, including translation, Clean Up and always-listening Hey Siri.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable six Apple Intelligence features, including translation, Clean Up and always-listening Hey Siri."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用 6 项 Apple 智能功能，包括翻译、照片消除和常听 Hey Siri。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
