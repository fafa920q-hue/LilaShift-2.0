    "This restores all %d keys of %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This restores all %d keys of %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将恢复 %d 个键（%@）。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto restaura todas las %d claves de %@."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این همه %d کلید %@ را بازیابی می‌کند."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これにより %d 個のキー（%@）すべてが復元されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%d개의 키(%@)를 모두 복원합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это восстанавливает все %d ключей %@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này khôi phục tất cả %d khóa của %@."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "這將還原 %d 個鍵（%@）。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "這將還原 %d 個鍵（%@）。"
          }
        }
      }
    },
    "This restores both eSIM flags together.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This restores both eSIM flags together."
          }
        },
        "zh-Hans": {
