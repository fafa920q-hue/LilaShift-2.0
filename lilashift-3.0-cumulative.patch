+            if item.kind == .page {
+                Image(systemName: "chevron.right")
+                    .font(.subheadline.weight(.semibold))
+                    .foregroundStyle(.tertiary)
+            }
+        }
+    }
+
+    private func riskTitle(_ risk: CapabilityRiskLevel) -> String {
+        switch risk {
+        case .low: return L("Low")
+        case .medium: return L("Medium")
+        case .high: return L("High")
+        }
+    }
+
+    private func riskColor(_ risk: CapabilityRiskLevel) -> Color {
+        switch risk {
+        case .low: return GlassTokens.successColor
+        case .medium: return GlassTokens.warningColor
+        case .high: return GlassTokens.dangerColor
+        }
+    }
+
+    private func recordUse(_ id: String) {
+        let updated = FeatureCatalog.recordingUse(id, in: catalogSettings)
+        guard updated != catalogSettings else { return }
+        saveCatalogSettings(updated)
+    }
+
+    private func toggleFavorite(_ id: String) {
+        guard let deviceID = RestoreIntelligence.installationDeviceID else {
+            favoritesError = L("History is unavailable: no installation ID has been recorded yet.")
+            return
+        }
+        let store = PresetFavoritesStore(
+            directory: RestoreIntelligence.historyDirectory, deviceID: deviceID)
+        do {
+            favoriteIDs = try store.toggle(id)
+            favoritesError = nil
+        } catch {
+            favoritesError = L("The favorites could not be saved and verified. No system changes were made.")
+        }
+    }
+
+    private func reloadFavorites() {
+        guard let deviceID = RestoreIntelligence.installationDeviceID else {
+            favoriteIDs = []
+            favoritesError = L("History is unavailable: no installation ID has been recorded yet.")
+            return
+        }
+        let store = PresetFavoritesStore(
+            directory: RestoreIntelligence.historyDirectory, deviceID: deviceID)
+        let loaded = store.load()
+        favoriteIDs = loaded.ids
+        favoritesError = loaded.error
+    }
+
+    private func reloadCatalogSettings() {
+        guard let deviceID = RestoreIntelligence.installationDeviceID else {
+            catalogSettings = .defaults
+            catalogSettingsError = L("History is unavailable: no installation ID has been recorded yet.")
+            return
+        }
+        let store = FeatureCatalogSettingsStore(
+            directory: RestoreIntelligence.historyDirectory, deviceID: deviceID)
+        let loaded = store.load()
+        catalogSettings = loaded.settings
+        catalogSettingsError = loaded.error
+    }
+
+    private func saveCatalogSettings(_ updated: FeatureCatalogSettings) {
+        catalogSettings = updated
+        guard let deviceID = RestoreIntelligence.installationDeviceID else {
+            catalogSettingsError = L("History is unavailable: no installation ID has been recorded yet.")
+            return
+        }
+        let store = FeatureCatalogSettingsStore(
+            directory: RestoreIntelligence.historyDirectory, deviceID: deviceID)
+        do {
+            try store.save(updated)
+            catalogSettingsError = nil
+        } catch {
+            catalogSettingsError = L("The settings could not be saved and verified. No system changes were made.")
+        }
+    }
+
+    private func reloadSettings() {
+        guard let deviceID = RestoreIntelligence.installationDeviceID else {
+            settings = .defaults
+            lastSavedSettings = .defaults
+            settingsError = L("History is unavailable: no installation ID has been recorded yet.")
+            return
+        }
+        let store = PersonalizationSettingsStore(
+            directory: RestoreIntelligence.historyDirectory, deviceID: deviceID)
+        let loaded = store.load()
+        settings = loaded.settings
+        lastSavedSettings = loaded.settings
+        settingsError = loaded.error
+    }
+
+    private func updateSettings(_ change: (inout PersonalizationSettings) -> Void) {
+        var updated = settings
+        change(&updated)
+        settings = updated
+        guard let deviceID = RestoreIntelligence.installationDeviceID else {
+            settings = lastSavedSettings
+            settingsError = L("History is unavailable: no installation ID has been recorded yet.")
+            return
+        }
+        let store = PersonalizationSettingsStore(
+            directory: RestoreIntelligence.historyDirectory, deviceID: deviceID)
+        do {
+            try store.save(updated)
+            lastSavedSettings = updated
+            settingsError = nil
+        } catch {
+            settings = lastSavedSettings
+            settingsError = L("The settings could not be saved and verified. No system changes were made.")
+        }
+    }
+}
+
+// MARK: - Manage sheet
+
+/// Drag reorder, hide / show and restore defaults for the catalog.
+/// Every change saves immediately (like the dashboard reorder
+/// sheet): there is no unsaved draft to lose. The list shows every
+/// item in the current order, hidden ones included and marked, so
+/// a hidden item can always be shown again from here.
+private struct FeatureCatalogManageView: View {
+    @Binding var settings: FeatureCatalogSettings
+    let catalogSort: CatalogSort
+    let favoritesFirst: Bool
+    let favoriteIDs: Set<String>
+    let save: (FeatureCatalogSettings) -> Void
+    let restoreDefaults: () -> Void
+    @Environment(\.dismiss) private var dismiss
+
+    /// Every item in the current order (hidden included): the same
+    /// single ordering rule, without search or category filters, so
+    /// a drag reorder stores the full order.
+    private var orderedItems: [FeatureCatalogItem] {
+        HomeSorting.sortCatalogItems(
+            FeatureCatalog.allItems, by: catalogSort,
+            favoritesFirst: favoritesFirst, favoriteIDs: favoriteIDs,
+            customOrder: settings.customOrder, recentIDs: settings.recentIDs)
+    }
+
+    var body: some View {
+        NavigationStack {
+            List {
+                ForEach(orderedItems) { item in
+                    HStack(spacing: 10) {
+                        Image(systemName: item.symbol)
+                            .foregroundStyle(Color.gestaltAccent)
+                            .frame(width: 24)
+                        VStack(alignment: .leading, spacing: 2) {
+                            Text(item.chineseName)
+                                .font(.subheadline.weight(.semibold))
+                            Text(item.category.title)
+                                .font(.caption)
+                                .foregroundStyle(.secondary)
+                        }
+                        Spacer(minLength: 4)
+                        Button(settings.hiddenIDs.contains(item.id) ? L("Show") : L("Hide")) {
+                            var updated = settings
+                            if updated.hiddenIDs.contains(item.id) {
+                                updated.hiddenIDs.remove(item.id)
+                            } else {
+                                updated.hiddenIDs.insert(item.id)
+                            }
+                            settings = updated
+                            save(updated)
+                        }
+                        .font(.subheadline)
+                        .frame(minHeight: GlassTokens.buttonMinHeight)
+                    }
+                    .opacity(settings.hiddenIDs.contains(item.id) ? 0.5 : 1)
+                }
+                .onMove { offsets, destination in
+                    var ids = orderedItems.map(\.id)
+                    ids.move(fromOffsets: offsets, toOffset: destination)
+                    var updated = settings
+                    updated.customOrder = ids
+                    settings = updated
+                    save(updated)
+                }
+            }
+            .environment(\.editMode, .constant(EditMode.active))
+            .navigationTitle(L("Custom Order"))
+            .toolbar {
+                ToolbarItem(placement: .topBarLeading) {
+                    Button(L("Restore Defaults")) { restoreDefaults() }
+                }
+                ToolbarItem(placement: .topBarTrailing) {
+                    Button(L("Done")) { dismiss() }
+                }
+            }
+        }
+    }
+}
diff --git a/GestaltX/HistoryRestoreSummary.swift b/GestaltX/HistoryRestoreSummary.swift
new file mode 100644
index 0000000..02950bd
--- /dev/null
+++ b/GestaltX/HistoryRestoreSummary.swift
@@ -0,0 +1,359 @@
+// SPDX-License-Identifier: GPL-3.0-only
+// History & restore experience (Phase G) — ONE coherent
+// presentation of the history data that already exists.
+//
+// The storage already exists (HistoryJournal / ChangeRecordStore /
+// RestoreIntelligence / DeviceFingerprint /
+// PostModificationAcceptance); this file only presents it as one
+// unified view. It never writes the device file, never changes a
+// record's meaning, and never adds a restore path: restore execution
+// stays in GestaltManager's existing paths, reached only through the
+// preview + second confirmation in the views.
+//
+// Honesty rules:
+// - The first-read value is the "first-recorded value", never the
+//   factory original. A first read cannot prove the device was
+//   unmodified before this app first saw it; the label says so.
+// - A staged value is shown only when the working document actually
+//   differs from the first-recorded value for that key; otherwise
+//   there is no staged change to show.
+// - A restore preview must show, before execution: device identity,
+//   file integrity, backup source, current system compatibility,
+//   and the before/after diff. Anything that cannot be verified is
+//   shown as unknown, never as verified.
+// - High-risk operations (restore, apply) need a second
+//   confirmation. `TwoStepConfirmation` is the gate the views use:
+//   the first tap arms it (and reveals the preview), only the
+//   second tap executes.
+import Foundation
+
+// MARK: - Unified history entry
+
+/// One row of the unified history & restore view: the
+/// first-recorded value, the current value, the staged value (when
+/// there is one), the operation record behind it, the trusted
+/// backups, the restore state and the verification results — all
+/// from the existing stores, presented together.
+struct UnifiedHistoryEntry: Equatable, Sendable, Identifiable {
+    let id: UUID
+    let date: Date
+    let title: String
+    let key: String
+    let layer: ChangeLayer
+    /// The value as first recorded. Labelled by
+    /// `firstRecordedLabel` — "First-recorded value" for a first
+    /// read, never "factory original" unless the provenance is
+    /// `.verifiedFactory`.
+    let firstRecordedValue: ChangeValue
+    let firstRecordedLabel: String
+    let currentValue: ChangeValue?
+    /// The value in the working (staged) document, or `nil` when
+    /// the working value equals the first-recorded value — i.e.
+    /// there is no staged change for this key.
+    let stagedValue: ChangeValue?
+    let isRecordedOperation: Bool
+    let backupProvenance: BackupProvenance
+    let backupSourceLabel: String
+    let restoreState: RestoreTimelineStatus
+    let restartVerified: Bool
+    /// Whether an automatic restore is allowed for this entry
+    /// (trusted original + locatable slot + matching layout).
+    let autoRestorable: Bool
+    /// The eligibility reason: why it can, or cannot, be restored.
+    let restoreReason: String
+    /// Whether any stored backup verified (file exists, byte count
+    /// and SHA-256 match, parses as a plist). A global fact about
+    /// the backup store, labelled as such — not a per-change claim.
+    let verifiedBackupOnFile: Bool
+}
+
+enum HistoryRestoreSummary {
+    /// Builds the unified entries from the timeline (which already
+    /// merges recorded operations with detected differences), the
+    /// persisted records, the first-read snapshot, the working
+    /// document and the backup verifications. Order follows the
+    /// timeline (newest first). Pure: reads only its parameters.
+    static func unifiedEntries(
+        timeline: [RestoreTimelineEntry],
+        records: [RecordedChange],
+        snapshot: GestaltDocument?,
+        working: GestaltDocument?,
+        layout: MobileGestaltCacheLayout?,
+        verifications: [BackupVerification]
+    ) -> [UnifiedHistoryEntry] {
+        let verifiedBackupOnFile = verifications.contains { $0.status == .verified }
+        return timeline.map { entry in
+            let recorded = records.first { $0.id == entry.id }
+            let staged = stagedValue(for: entry, snapshot: snapshot, working: working, layout: layout)
+            let (autoRestorable, restoreReason) = restoreEligibility(
+                entry: entry, recorded: recorded, current: working, layout: layout)
+            return UnifiedHistoryEntry(
+                id: entry.id, date: entry.date, title: entry.title,
+                key: entry.key, layer: entry.layer,
+                firstRecordedValue: entry.original,
+                firstRecordedLabel: entry.provenanceLabel,
+                currentValue: entry.current,
+                stagedValue: staged,
+                isRecordedOperation: entry.isRecordedOperation,
+                backupProvenance: entry.provenance,
+                backupSourceLabel: RestoreIntelligence.provenanceLabel(for: entry.provenance),
+                restoreState: entry.status,
+                restartVerified: entry.restartVerified,
+                autoRestorable: autoRestorable,
+                restoreReason: restoreReason,
+                verifiedBackupOnFile: verifiedBackupOnFile)
+        }
+    }
+
+    /// The staged value for one timeline entry: the working
+    /// document's value for the key, or `nil` when there is no
+    /// working document, the value cannot be read, or it equals the
+    /// first-recorded value (no staged change).
+    static func stagedValue(
+        for entry: RestoreTimelineEntry,
+        snapshot: GestaltDocument?,
+        working: GestaltDocument?,
+        layout: MobileGestaltCacheLayout?
+    ) -> ChangeValue? {
+        guard let working else { return nil }
+        let staged: ChangeValue?
+        switch entry.layer {
+        case .cacheExtra:
+            staged = ChangeValue.fromPlistValue(working.extra[entry.key])
+        case .artwork:
+            staged = ChangeValue.fromPlistValue(working.artwork[entry.key])
+        case .cacheData:
+            staged = slotValue(entry.key, in: working, using: layout)
+        }
+        guard let staged, staged != entry.original else { return nil }
+        return staged
+    }
+
+    /// Whether the entry may be auto-restored, with the reason.
+    /// Recorded changes go through the existing eligibility
+    /// checker; detected differences (no recorded operation, first
+    /// read only) are never auto-restorable — there is no trusted
+    /// original to restore from.
+    static func restoreEligibility(
+        entry: RestoreTimelineEntry, recorded: RecordedChange?,
+        current: GestaltDocument?, layout: MobileGestaltCacheLayout?
+    ) -> (autoRestorable: Bool, reason: String) {
+        guard let recorded, let current else {
+            return (false, L("A precise restore cannot be guaranteed without a trusted backup. Use read-only diagnostics or import a backup instead."))
+        }
+        switch RestoreEligibilityChecker.eligibility(
+            for: recorded, record: nil, current: current, layout: layout) {
+        case .restorable(_, let reason):
+            return (true, reason)
+        case .notRestorable(let reason):
+            return (false, reason)
+        }
+    }
+
+    /// Reads one CacheData slot value, mirroring
+    /// `RestorePreviewBuilder`'s slot reading for the five known
+    /// keys; any other key or unresolvable slot reads as `nil`,
+    /// never guessed.
+    static func slotValue(
+        _ key: String, in document: GestaltDocument,
+        using layout: MobileGestaltCacheLayout?
+    ) -> ChangeValue? {
+        guard let layout else { return nil }
+        switch key {
+        case DeviceCacheOptions.greenTeaKey:
+            return (try? DeviceCacheOptions.flags(in: document, using: layout)).map { .bool($0.greenTea) }
+        case DeviceCacheOptions.notGreenTeaKey:
+            return (try? DeviceCacheOptions.flags(in: document, using: layout)).map { .bool($0.notGreenTea) }
+        case DeviceCacheOptions.wapiKey:
+            return (try? DeviceCacheOptions.wapi(in: document, using: layout)).map(ChangeValue.bool)
+        case DeviceCacheOptions.audioIntelligenceKey, DeviceCacheOptions.personalTranslatorKey:
+            return DeviceCacheOptions.advAISlotValue(key, in: document, using: layout)
+                .map(ChangeValue.bool)
+        default:
+            return nil
+        }
+    }
+}
+
+// MARK: - Restore preview checklist
+
+/// The five things the restore confirmation must show before a
+/// restore executes: device identity, file integrity, backup
+/// source, current system compatibility, and the before/after diff.
+/// `nil` outcomes mean "could not be verified" — shown as unknown,
+/// never as a pass.
+struct RestorePreviewChecklist: Equatable, Sendable {
+    /// "This device", "Another device", or "Unknown" (no
+    /// installation id recorded yet).
+    let deviceIdentity: String
+    /// Whether the change/backup belongs to this device, or `nil`
+    /// when it could not be determined.
+    let deviceMatches: Bool?
+    /// The device name shown to the user (the connected device's
+    /// display name), so the identity can be checked at a glance.
+    let deviceDisplayName: String
+    let fileIntegrity: String
+    /// Whether the backup file verified, or `nil` when there is no
+    /// backup file to check for this change.
+    let fileIntegrityOK: Bool?
+    /// The backup's provenance label ("Verified factory backup",
+    /// "First-read device state", ...).
+    let backupSource: String
+    let systemCompatible: String
+    /// Whether the current cache layout matches, or `nil` when the
+    /// layout could not be resolved.
+    let systemCompatibleOK: Bool?
+    /// The value currently in the document, or `nil` when it could
+    /// not be read.
+    let beforeValue: ChangeValue?
+    /// The value a restore would write back, or `nil` for a
+    /// whole-backup restore (every field, no single value).
+    let afterValue: ChangeValue?
+
+    /// True only when no check failed. Unknown checks do not pass
+    /// the gate by themselves — they are shown as unknown and the
+    /// caller still asks the user to confirm — but they do not
+    /// block the way a failed check does: a failed device match, a
+    /// failed file check or a layout mismatch is a hard stop in the
+    /// UI (the restore button stays disabled).
+    var noCheckFailed: Bool {
+        deviceMatches != false && fileIntegrityOK != false && systemCompatibleOK != false
+    }
+}
+
+enum RestorePreviewChecklistBuilder {
+    /// The checklist for restoring one recorded change. `item` is
+    /// the `RestorePreviewBuilder` item for the change (it carries
+    /// the before/after diff); `verifications` are the stored
+    /// backup verifications; `deviceID` is the installation device
+    /// id (`nil` when none was recorded); `current` is the working
+    /// document and `layout` its resolved layout.
+    static func build(
+        change: RecordedChange, item: RestoreItemPreview,
+        verifications: [BackupVerification], deviceID: String?,
+        deviceDisplayName: String, current: GestaltDocument?,
+        layout: MobileGestaltCacheLayout?
+    ) -> RestorePreviewChecklist {
+        let deviceIdentity = deviceIdentityText(changeDeviceID: change.deviceID, deviceID: deviceID)
+        let deviceMatches = deviceMatch(changeDeviceID: change.deviceID, deviceID: deviceID)
+        let (fileIntegrity, fileIntegrityOK) = fileIntegrityForChange(
+            change: change, verifications: verifications)
+        return RestorePreviewChecklist(
+            deviceIdentity: deviceIdentity, deviceMatches: deviceMatches,
+            deviceDisplayName: deviceDisplayName,
+            fileIntegrity: fileIntegrity, fileIntegrityOK: fileIntegrityOK,
+            backupSource: change.backupProvenance.displayLabel,
+            systemCompatible: systemCompatibilityText(current: current, layout: layout),
+            systemCompatibleOK: systemCompatibility(current: current, layout: layout),
+            beforeValue: item.currentValue, afterValue: item.targetValue)
+    }
+
+    /// The checklist for restoring a whole backup file. The backup
+    /// record itself is the file being verified, so file integrity
+    /// is exact (not the best-effort match used for single changes).
+    /// The diff is whole-file: there is no single before/after
+    /// value, so both are `nil` and the UI says so.
+    static func buildForBackup(
+        record: BackupRecord, verifications: [BackupVerification],
+        deviceID: String?, deviceDisplayName: String,
+        current: GestaltDocument?, layout: MobileGestaltCacheLayout?
+    ) -> RestorePreviewChecklist {
+        let deviceIdentity = deviceIdentityText(changeDeviceID: record.deviceID, deviceID: deviceID)
+        let deviceMatches = deviceMatch(changeDeviceID: record.deviceID, deviceID: deviceID)
+        let verification = verifications.first { $0.record.id == record.id }
+        let (fileIntegrity, fileIntegrityOK): (String, Bool?) = {
+            switch verification?.status {
+            case .verified:
+                return (L("Verified."), true)
+            case .failed(let reason):
+                return (reason, false)
+            case .notFound, nil:
+                return (L("Backup file not found."), false)
+            }
+        }()
+        return RestorePreviewChecklist(
+            deviceIdentity: deviceIdentity, deviceMatches: deviceMatches,
+            deviceDisplayName: deviceDisplayName,
+            fileIntegrity: fileIntegrity, fileIntegrityOK: fileIntegrityOK,
+            backupSource: record.provenance.displayLabel,
+            systemCompatible: systemCompatibilityText(current: current, layout: layout),
+            systemCompatibleOK: systemCompatibility(current: current, layout: layout),
+            beforeValue: nil, afterValue: nil)
+    }
+
+    // MARK: - Helpers
+
+    private static func deviceIdentityText(changeDeviceID: String, deviceID: String?) -> String {
+        guard let deviceID else { return L("Unknown") }
+        return changeDeviceID == deviceID ? L("This device") : L("Another device")
+    }
+
+    private static func deviceMatch(changeDeviceID: String, deviceID: String?) -> Bool? {
+        guard let deviceID else { return nil }
+        return changeDeviceID == deviceID
+    }
+
+    /// File integrity for one change: there is no per-change backup
+    /// file, so this matches verifications by device id. A verified
+    /// backup for this device means a verified file exists; no
+    /// verification at all means there is nothing to check (unknown,
+    /// not failed); a present-but-unverified file reports its
+    /// specific failure reason.
+    private static func fileIntegrityForChange(
+        change: RecordedChange, verifications: [BackupVerification]
+    ) -> (String, Bool?) {
+        let own = verifications.filter { $0.record.deviceID == change.deviceID }
+        if own.contains(where: { $0.status == .verified }) {
+            return (L("Verified backup on file."), true)
+        }
+        if own.isEmpty {
+            return (L("No verified backup file for this change."), nil)
+        }
+        for verification in own {
+            if case .failed(let reason) = verification.status {
+                return (reason, false)
+            }
+        }
+        return (L("Backup file not found."), false)
+    }
+
+    private static func systemCompatibilityText(
+        current: GestaltDocument?, layout: MobileGestaltCacheLayout?
+    ) -> String {
+        switch systemCompatibility(current: current, layout: layout) {
+        case true: return L("Verified. Cache layout matches this device.")
+        case false: return L("Verified, but the cache layout differs from this device.")
+        case nil: return L("Unknown")
+        }
+    }
+
+    private static func systemCompatibility(
+        current: GestaltDocument?, layout: MobileGestaltCacheLayout?
+    ) -> Bool? {
+        guard let current, let layout else { return nil }
+        return layout.matches(current)
+    }
+}
+
+// MARK: - High-risk second confirmation
+
+/// The gate for high-risk operations (restore, apply): the first
+/// tap arms it and reveals the preview, only the second tap
+/// executes. The views hold one of these per restore button; the
+/// gate itself is pure and unit-tested, so the "second confirmation"
+/// is behavior, not just a label.
+struct TwoStepConfirmation: Equatable, Sendable {
+    private(set) var armed = false
+
+    /// Requests execution. Returns `true` only on the second
+    /// consecutive request (the confirmation); the first request
+    /// arms the gate and returns `false` (do not execute).
+    mutating func request() -> Bool {
+        if armed { return true }
+        armed = true
+        return false
+    }
+
+    /// Disarms the gate (for example when the sheet closes).
+    mutating func reset() { armed = false }
+}
diff --git a/GestaltX/HomeDiagnosticsCache.swift b/GestaltX/HomeDiagnosticsCache.swift
new file mode 100644
index 0000000..6d10740
--- /dev/null
+++ b/GestaltX/HomeDiagnosticsCache.swift
@@ -0,0 +1,320 @@
+// SPDX-License-Identifier: GPL-3.0-only
+// HomeDiagnosticsCache — one shared, cached home-diagnostics
+// computation for the Tools home.
+//
+// Problem: every diagnostics card recomputed the same expensive
+// values as a SwiftUI computed property, on EVERY body evaluation.
+// The device report, backup verification (disk reads + SHA-256 of
+// every backup file), the one-tap SafePatch simulation, the health
+// score, the Modified Values report and the fingerprint capture were
+// each computed up to three times per body evaluation — and the body
+// is re-evaluated whenever ANY GestaltManager @Published property
+// changes (including the session log, which appends during a read).
+// That is what made the home scroll lag.
+//
+// Fix: this cache computes each shared value ONCE per input change,
+// on a background task, and publishes the result. The cards read the
+// cached value (cheap) instead of recomputing. The cache keeps the
+// previous values while a refresh is in flight, so the home never
+// flashes empty. A value is only published when it actually changed
+// (all cached types are Equatable), so a refresh that produces the
+// same values does not rebuild the home.
+//
+// Invalidation (what triggers a refresh, and what it means):
+//   - ContentView drives `refresh(snapshot:working:backups:)` on
+//     appear and whenever the snapshot data, the backup inventory or
+//     the staged-change count changes. A refresh is also triggered
+//     after an explicit backup/restore, via `refresh()`.
+//   - The inputs are the snapshot, the working document and the
+//     backup inventory. Anything derived from them (report, health,
+//     simulations, verifications, fingerprint, live values) is
+//     recomputed together in one background pass, so the cards can
+//     never disagree about the same underlying data.
+//   - The cache never writes anything: it only reads the snapshot,
+//     the working document, the backup files (read-only verification)
+//     and the history stores (read-only loads). All MobileGestalt
+//     writes, backups, restores and staging stay in GestaltManager.
+//   - Unknown stays unknown: a value that could not be computed
+//     (no snapshot, no history id, unreadable file) is published as
+//     nil / empty / unknown, never fabricated.
+//
+// Concurrency: the cache itself is @MainActor (it owns @Published
+// state). The heavy work runs in a `Task.detached` (the same pattern
+// AppAppearanceViews already uses for image work): the detached task
+// captures only Sendable inputs (the snapshot, working document and
+// backup records are all Sendable value types) and returns a
+// Sendable result; the outer Task (MainActor-isolated) applies it.
+// The history stores (ChangeRecordStore, DeviceFingerprintStore) are
+// Sendable structs whose `load()` does file I/O, so loading them on
+// the detached task moves the disk reads off the main thread. The
+// live-probe values are also read on the detached task: the live
+// Gestalt query can be slow, and it must never block scrolling.
+import SwiftUI
+
+/// The result of one background diagnostics computation. Every field
+/// is a Sendable value type, so the whole result can cross from the
+/// detached task back to the main actor safely.
+private struct HomeDiagnosticsResult: Sendable {
+    var deviceReport: LilaDeviceReport?
+    var backupVerifications: [BackupVerification]
+    var simulations: [SafePatchProposal: SafePatchSimulation]
+    var healthScore: SystemHealthScore?
+    var externalModificationCount: Int
+    var records: [RecordedChange]
+    var historyError: String?
+    var storedFingerprint: DeviceFingerprint?
+    var fingerprintError: String?
+    var currentFingerprint: DeviceFingerprint?
+    var liveValues: [String: ChangeValue]
+    /// Feature ids staged in the working document but not yet
+    /// applied (snapshot vs working diff), for the compatibility
+    /// status model (Phase F). Computed here once, so every card
+    /// shows the same staged set.
+    var stagedFeatureIDs: Set<String>
+    /// Feature ids applied but not yet verified after a restart,
+    /// for the compatibility status model (Phase F).
+    var pendingRestartFeatureIDs: Set<String>
+}
+
+/// Environment key for the shared diagnostics cache. The default is
+/// `nil`: a view that renders without the cache (for example the
+/// SwiftUI snapshot tests, which only provide a GestaltManager) falls
+/// back to computing directly, so its rendered output is unchanged.
+private struct HomeDiagnosticsCacheKey: EnvironmentKey {
+    static let defaultValue: HomeDiagnosticsCache? = nil
+}
+
+extension EnvironmentValues {
+    var homeDiagnosticsCache: HomeDiagnosticsCache? {
+        get { self[HomeDiagnosticsCacheKey.self] }
+        set { self[HomeDiagnosticsCacheKey.self] = newValue }
+    }
+}
+
+/// Returns the strings with duplicates removed, keeping the first
+/// occurrence of each, in order. Used to merge duplicate blocking
+/// reasons and identical status lines in the home cards; the
+/// underlying evaluations and evidence are still shown in full in
+/// the details, so nothing is lost.
+func deduplicated(_ values: [String]) -> [String] {
+    var seen = Set<String>()
+    return values.filter { seen.insert($0).inserted }
+}
+
+@MainActor
+final class HomeDiagnosticsCache: ObservableObject {
+    /// The per-device report (profile + eligibility evaluations), or
+    /// `nil` when the device has not been read yet.
+    @Published private(set) var deviceReport: LilaDeviceReport?
+    /// Read-only verification of every stored backup (disk reads +
+    /// SHA-256, computed on the background task).
+    @Published private(set) var backupVerifications: [BackupVerification] = []
+    /// SafePatch simulations for the three proposals the home shows,
+    /// keyed by proposal. The health and diagnosis cards use the
+    /// one-tap simulation; the simulator card uses the selected one.
+    @Published private(set) var simulations: [SafePatchProposal: SafePatchSimulation] = [:]
+    /// The health score, or `nil` when the device has not been read.
+    @Published private(set) var healthScore: SystemHealthScore?
+    /// Fields the Modified Values report found changed, minus the
+    /// keys this app recorded.
+    @Published private(set) var externalModificationCount: Int = 0
+    /// Recorded changes from the history store (loaded on the
+    /// background task, never on the main thread).
+    @Published private(set) var records: [RecordedChange] = []
+    /// Why the change history could not be read, if it could not.
+    @Published private(set) var historyError: String?
+    /// The stored device fingerprint, or `nil` when never recorded.
+    @Published private(set) var storedFingerprint: DeviceFingerprint?
+    /// Why the stored fingerprint could not be read, if it could not.
+    @Published private(set) var fingerprintError: String?
+    /// The fingerprint of the current snapshot, or `nil` when the
+    /// device has not been read yet.
+    @Published private(set) var currentFingerprint: DeviceFingerprint?
+    /// Live-probe values for the recorded CacheExtra changes, read
+    /// on the background task (the live Gestalt query can be slow).
+    @Published private(set) var liveValues: [String: ChangeValue] = [:]
+    /// Feature ids staged in the working document but not yet
+    /// applied. See `HomeDiagnosticsResult.stagedFeatureIDs`.
+    @Published private(set) var stagedFeatureIDs: Set<String> = []
+    /// Feature ids applied but not yet verified after a restart.
+    /// See `HomeDiagnosticsResult.pendingRestartFeatureIDs`.
+    @Published private(set) var pendingRestartFeatureIDs: Set<String> = []
+    /// True while a background refresh is in flight. The previous
+    /// cached values stay visible until the new ones arrive.
+    @Published private(set) var isComputing = false
+
+    private var refreshTask: Task<Void, Never>?
+
+    /// The one-tap simulation, or `nil` when it has not been
+    /// computed yet. Convenience for the health and diagnosis cards,
+    /// which always use the one-tap proposal.
+    var oneTapSimulation: SafePatchSimulation? {
+        simulations[SafePatchProposal.oneTap()]
+    }
+
+    /// Recomputes all cached diagnostics for the given inputs on a
+    /// background task. Safe to call often: an in-flight refresh is
+    /// cancelled, and a refresh that produces unchanged values does
+    /// not publish anything. Call this when the snapshot, the working
+    /// document or the backup inventory changes, and after an explicit
+    /// backup or restore.
+    func refresh(snapshot: DocumentSnapshot?, working: GestaltDocument?, backups: [BackupRecord]) {
+        refreshTask?.cancel()
+        isComputing = true
+        // These are cheap reads (URL construction / UserDefaults);
+        // the heavy file I/O happens inside the detached task.
+        let deviceID = RestoreIntelligence.installationDeviceID
+        let historyDirectory = RestoreIntelligence.historyDirectory
+        refreshTask = Task { [weak self] in
+            let result = await Task.detached(priority: .userInitiated) {
+                Self.compute(
+                    snapshot: snapshot, working: working, backups: backups,
+                    deviceID: deviceID, historyDirectory: historyDirectory)
+            }.value
+            guard let self, !Task.isCancelled else { return }
+            self.apply(result)
+            self.isComputing = false
+        }
+    }
+
+    /// Applies one computed result, publishing only the values that
+    /// actually changed, so a refresh that produces the same values
+    /// does not rebuild the home.
+    private func apply(_ result: HomeDiagnosticsResult) {
+        if deviceReport != result.deviceReport { deviceReport = result.deviceReport }
+        if backupVerifications != result.backupVerifications { backupVerifications = result.backupVerifications }
+        if simulations != result.simulations { simulations = result.simulations }
+        if healthScore != result.healthScore { healthScore = result.healthScore }
+        if externalModificationCount != result.externalModificationCount { externalModificationCount = result.externalModificationCount }
+        if records != result.records { records = result.records }
+        if historyError != result.historyError { historyError = result.historyError }
+        if storedFingerprint != result.storedFingerprint { storedFingerprint = result.storedFingerprint }
+        if fingerprintError != result.fingerprintError { fingerprintError = result.fingerprintError }
+        if currentFingerprint != result.currentFingerprint { currentFingerprint = result.currentFingerprint }
+        if liveValues != result.liveValues { liveValues = result.liveValues }
+        if stagedFeatureIDs != result.stagedFeatureIDs { stagedFeatureIDs = result.stagedFeatureIDs }
+        if pendingRestartFeatureIDs != result.pendingRestartFeatureIDs { pendingRestartFeatureIDs = result.pendingRestartFeatureIDs }
+    }
+
+    /// One background pass over the shared inputs. Pure: reads only
+    /// its parameters (and the history/backup files, read-only),
+    /// writes nothing, performs no UI work. Runs off the main thread
+    /// (`nonisolated`), so disk reads, SHA-256 verification and the
+    /// live probe never block scrolling.
+    nonisolated private static func compute(
+        snapshot: DocumentSnapshot?,
+        working: GestaltDocument?,
+        backups: [BackupRecord],
+        deviceID: String?,
+        historyDirectory: URL
+    ) -> HomeDiagnosticsResult {
+        // 1. History (disk I/O, background). A missing installation
+        // id means the history stores are unavailable — never scoped
+        // to a guessed id.
+        var records: [RecordedChange] = []
+        var historyError: String?
+        var storedFingerprint: DeviceFingerprint?
+        var fingerprintError: String?
+        if let deviceID {
+            let recordStore = ChangeRecordStore(directory: historyDirectory, deviceID: deviceID)
+            do {
+                records = try recordStore.load()
+            } catch {
+                records = []
+                historyError = L("The change history could not be read. No system changes were made.")
+            }
+            let fingerprintStore = DeviceFingerprintStore(directory: historyDirectory, deviceID: deviceID)
+            do {
+                storedFingerprint = try fingerprintStore.load()
+            } catch {
+                storedFingerprint = nil
+                fingerprintError = L("The device fingerprint could not be read. No system changes were made.")
+            }
+        } else {
+            historyError = L("History is unavailable: no installation ID has been recorded yet.")
+            fingerprintError = L("History is unavailable: no installation ID has been recorded yet.")
+        }
+
+        // 2. Device report (pure computation). Mirrors the cards:
+        // no snapshot means no report, never a fabricated one.
+        let deviceReport: LilaDeviceReport? = {
+            guard let snapshot else { return nil }
+            return LilaIntelligence.report(
+                snapshot: snapshot, backups: backups,
+                changeRecordCount: records.count)
+        }()
+
+        // 3. Backup verifications (disk reads + SHA-256, background).
+        // This is the same call the health, diagnosis and restore
+        // cards used to make separately on every body evaluation.
+        let verifications = RestoreIntelligence.verifyBackups(backups, against: working)
+
+        // 4. SafePatch simulations for the three proposals the home
+        // shows (pure computation, no file I/O).
+        let proposals = [
+            SafePatchProposal.oneTap(),
+            SafePatchProposal.aiOnly(),
+            SafePatchProposal.esimRegion(),
+        ]
+        var simulations: [SafePatchProposal: SafePatchSimulation] = [:]
+        for proposal in proposals {
+            simulations[proposal] = SafePatch.simulate(
+                proposal: proposal, snapshot: snapshot,
+                currentDocument: working, backups: backups)
+        }
+
+        // 5. External modifications (Modified Values report, pure).
+        let externalModificationCount: Int = {
+            let recordedKeys = Set(records.map(\.key))
+            return ModifiedValues.report(for: snapshot).rows
+                .filter { !recordedKeys.contains($0.key) }.count
+        }()
+
+        // 6. Health score (pure computation, uses the values above).
+        // Mirrors the health card: no snapshot means no score.
+        let healthScore: SystemHealthScore? = {
+            guard let report = deviceReport else { return nil }
+            return SystemHealthScorer.score(
+                profile: report.profile, snapshot: snapshot,
+                backups: backups, backupVerifications: verifications,
+                simulation: simulations[SafePatchProposal.oneTap()],
+                recordedChanges: records,
+                externalModificationCount: externalModificationCount)
+        }()
+
+        // 7. Current fingerprint (pure computation).
+        let currentFingerprint: DeviceFingerprint? = {
+            guard let report = deviceReport else { return nil }
+            return DeviceFingerprintCapture.capture(profile: report.profile, snapshot: snapshot)
+        }()
+
+        // 8. Live-probe values for the recorded CacheExtra changes.
+        // The live Gestalt query can be slow, so it runs here on the
+        // background task, never on the main thread or in a body.
+        let liveValues = PostModificationAcceptance.liveValues(for: records)
+
+        // 9. Compatibility-status inputs (Phase F): the staged set
+        // (snapshot vs working diff) and the restart-pending set
+        // (applied records not yet restart-verified). Pure reads of
+        // the values above; no eligibility is recomputed here.
+        let stagedFeatureIDs = CompatibilityStatusResolver.stagedFeatureIDs(
+            snapshot: snapshot, working: working)
+        let pendingRestartFeatureIDs = CompatibilityStatusResolver.pendingRestartFeatureIDs(
+            records: records)
+
+        return HomeDiagnosticsResult(
+            deviceReport: deviceReport,
+            backupVerifications: verifications,
+            simulations: simulations,
+            healthScore: healthScore,
+            externalModificationCount: externalModificationCount,
+            records: records,
+            historyError: historyError,
+            storedFingerprint: storedFingerprint,
+            fingerprintError: fingerprintError,
+            currentFingerprint: currentFingerprint,
+            liveValues: liveValues,
+            stagedFeatureIDs: stagedFeatureIDs,
+            pendingRestartFeatureIDs: pendingRestartFeatureIDs)
+    }
+}
diff --git a/GestaltX/HomeDiagnosticsSection.swift b/GestaltX/HomeDiagnosticsSection.swift
new file mode 100644
index 0000000..7d62841
--- /dev/null
+++ b/GestaltX/HomeDiagnosticsSection.swift
@@ -0,0 +1,269 @@
+// SPDX-License-Identifier: GPL-3.0-only
+// Home diagnostics section + detail pages.
+//
+// The Tools home used to inline every diagnostics card (eleven full
+// cards, ~16 glass cards in one scroll view). That made the home long,
+// duplicated the same summaries in several cards, and forced every
+// card to build and lay out at once. The home now shows only a
+// compact diagnostics summary plus one row per diagnostic area; the
+// full card lives on a secondary page behind a NavigationLink. The
+// full cards themselves are unchanged (the SwiftUI snapshot tests
+// render them in isolation), only where they are hosted changed.
+//
+// The section ids are stable: they are the ordering keys stored in
+// PersonalizationSettings (`homeSectionOrder`). The categories are
+// fixed and semantically clear — each id names one diagnostic area,
+// and the order is the enum's CaseIterable order unless the user
+// reordered them in the Personalization Center.
+import SwiftUI
+
+/// One diagnostic area on the Tools home. The raw value is the
+/// stable id stored in PersonalizationSettings.
+enum HomeDiagnosticsSectionID: String, CaseIterable, Identifiable, Sendable {
+    case lilaIntelligence
+    case safePatch
+    case restore
+    case healthScore
+    case dependencyAnalyzer
+    case deviceFingerprint
+    case acceptance
+    case faultDiagnosis
+    case presetCatalog
+    case personalization
+    case diagnosticsExpansion
+
+    var id: String { rawValue }
+
+    /// The default order of the sections on the home.
+    static let defaultOrder: [HomeDiagnosticsSectionID] = allCases
+
+    /// The sections to show on the home, in the user's preferred
+    /// order, with hidden sections removed. A stored order that
+    /// omits a section (for example one added in a later version)
+    /// gets the missing sections appended in default order, so no
+    /// section silently disappears. Unknown ids are ignored.
+    static func orderedVisibleSections(_ settings: PersonalizationSettings) -> [HomeDiagnosticsSectionID] {
+        let hidden = settings.hiddenHomeSections ?? []
+        let ordered: [HomeDiagnosticsSectionID]
+        if let stored = settings.homeSectionOrder {
+            let known = stored.compactMap { HomeDiagnosticsSectionID(rawValue: $0) }
+            let missing = defaultOrder.filter { !known.contains($0) }
+            ordered = known + missing
+        } else {
+            ordered = defaultOrder
+        }
+        return ordered.filter { !hidden.contains($0.rawValue) }
+    }
+
+    var title: String {
+        switch self {
+        case .lilaIntelligence: return L("Lila Intelligence")
+        case .safePatch: return L("SafePatch Simulator")
+        case .restore: return L("Restore Intelligence")
+        case .healthScore: return L("System Health Score")
+        case .dependencyAnalyzer: return L("Dependency Analyzer")
+        case .deviceFingerprint: return L("Device Capability Fingerprint")
+        case .acceptance: return L("Post-Modification Acceptance")
+        case .faultDiagnosis: return L("Smart Fault Diagnosis")
+        case .presetCatalog: return L("Preset Catalog")
+        case .personalization: return L("Personalization Center")
+        case .diagnosticsExpansion: return L("Diagnostics Expansion")
+        }
+    }
+
+    var subtitle: String {
+        switch self {
+        case .lilaIntelligence:
+            return L("Personalized recommendations for this device, generated locally from real readings.")
+        case .safePatch:
+            return L("See what a change would do before you enable it. Simulation only — nothing is written.")
+        case .restore:
+            return L("Modification timeline and precise restore, from trusted records only.")
+        case .healthScore:
+            return L("Cache, compatibility, backup and modification risk, from real readings only.")
+        case .dependencyAnalyzer:
+            return L("Dependencies, conflicts and duplicates for a proposal, before you stage it.")
+        case .deviceFingerprint:
+            return L("This device's real capabilities and build, recorded locally with a SHA-256 digest.")
+        case .acceptance:
+            return L("Re-read the device after a restart and check what actually stuck.")
+        case .faultDiagnosis:
+            return L("What went wrong, why, and what to try — from real readings only.")
+        case .presetCatalog:
+            return L("Search, filter and save presets — from the catalog only.")
+        case .personalization:
+            return L("Custom presets, catalog sort and Tools page cards — saved on this device only.")
+        case .diagnosticsExpansion:
+            return L("Battery, app cache, connection status and the operation log — read-only.")
+        }
+    }
+
+    var symbol: String {
+        switch self {
+        case .lilaIntelligence: return "brain"
+        case .safePatch: return "shield.checkered"
+        case .restore: return "clock.arrow.circlepath"
+        case .healthScore: return "heart.text.square"
+        case .dependencyAnalyzer: return "point.3.connected.trianglepath.dotted"
+        case .deviceFingerprint: return "fingerprint"
+        case .acceptance: return "checkmark.seal"
+        case .faultDiagnosis: return "stethoscope"
+        case .presetCatalog: return "books.vertical"
+        case .personalization: return "paintpalette"
+        case .diagnosticsExpansion: return "waveform.path.ecg"
+        }
+    }
+
+    /// The full card for this area, hosted on its detail page.
+    /// The card itself is unchanged; only where it is hosted moved.
+    @ViewBuilder
+    var detailContent: some View {
+        switch self {
+        case .lilaIntelligence: LilaIntelligenceCard()
+        case .safePatch: SafePatchCard()
+        case .restore: RestoreIntelligenceCard()
+        case .healthScore: SystemHealthScoreCard()
+        case .dependencyAnalyzer: DependencyAnalyzerCard()
+        case .deviceFingerprint: DeviceFingerprintCard()
+        case .acceptance: PostModificationAcceptanceCard()
+        case .faultDiagnosis: SmartFaultDiagnosisCard()
+        case .presetCatalog: PresetCatalogCard()
+        case .personalization: PersonalizationCenterCard()
+        case .diagnosticsExpansion: DiagnosticsExpansionCard()
+        }
+    }
+}
+
+/// The compact diagnostics summary shown on the home: the health
+/// score, the one-tap simulation verdict and the recorded-change
+/// count, all from the shared cache (no recomputation). It is a
+/// summary only — the full cards live on the detail pages below.
+/// Unknown stays unknown: an unread device shows "Unknown", never a
+/// fabricated score.
+struct DiagnosticsSummaryCard: View {
+    @EnvironmentObject private var model: GestaltManager
+    @Environment(\.homeDiagnosticsCache) private var diagnostics: HomeDiagnosticsCache?
+
+    var body: some View {
+        GlassCard(cornerRadius: GlassTokens.cardRadius) {
+            VStack(alignment: .leading, spacing: 12) {
+                HStack(spacing: 12) {
+                    GlassIconPedestal(systemImage: "heart.text.square", tint: .gestaltAccent, size: 44)
+                    VStack(alignment: .leading, spacing: 2) {
+                        Text(L("Diagnostics Summary"))
+                            .font(.headline)
+                            .foregroundStyle(.primary)
+                        Text(L("Health, simulation and recorded changes at a glance. Details are on the pages below."))
+                            .font(.subheadline)
+                            .foregroundStyle(.secondary)
+                    }
+                }
+                if model.snapshot == nil {
+                    Text(L("Read the device first to see the diagnostics summary."))
+                        .font(.subheadline)
+                        .foregroundStyle(.secondary)
+                } else {
+                    HStack(spacing: 12) {
+                        summaryChip(
+                            value: healthScoreText,
+                            label: L("Health Score"),
+                            color: .gestaltAccent)
+                        summaryChip(
+                            value: simulationText,
+                            label: L("Simulation"),
+                            color: simulationColor)
+                        summaryChip(
+                            value: "\(recordCount)",
+                            label: L("Recorded Changes"),
+                            color: .secondary)
+                    }
+                }
+            }
+        }
+    }
+
+    private var healthScoreText: String {
+        guard let score = diagnostics?.healthScore?.overallScore else { return L("Unknown") }
+        return "\(score)"
+    }
+
+    private var simulationText: String {
+        guard let simulation = diagnostics?.oneTapSimulation else { return L("Unknown") }
+        return simulation.canProceed ? L("Passed") : L("Blocked")
+    }
+
+    private var simulationColor: Color {
+        guard let simulation = diagnostics?.oneTapSimulation else { return .secondary }
+        return simulation.canProceed ? .green : .red
+    }
+
+    private var recordCount: Int {
+        diagnostics?.records.count ?? 0
+    }
+
+    @ViewBuilder
+    private func summaryChip(value: String, label: String, color: Color) -> some View {
+        VStack(spacing: 1) {
+            Text(value)
+                .font(.headline)
+                .foregroundStyle(color)
+                .lineLimit(1)
+                .minimumScaleFactor(0.7)
+            Text(label)
+                .font(.caption)
+                .foregroundStyle(.secondary)
+                .lineLimit(2)
+                .multilineTextAlignment(.center)
+        }
+        .frame(maxWidth: .infinity)
+        .padding(.vertical, 6)
+        .background(color.opacity(0.08), in: RoundedRectangle(cornerRadius: 10))
+    }
+}
+
+/// One row per diagnostic area: the area's icon, title and subtitle,
+/// linking to the full card on a secondary page. The rows render in
+/// `order` (the user's preferred order from PersonalizationSettings,
+/// or the default order). Hidden sections are omitted by the caller.
+struct HomeDiagnosticsSection: View {
+    let order: [HomeDiagnosticsSectionID]
+
+    var body: some View {
+        VStack(alignment: .leading, spacing: 12) {
+            Text(L("Diagnostics"))
+                .font(.headline)
+            ForEach(order) { section in
+                NavigationLink {
+                    HomeDiagnosticsDetailPage(section: section)
+                } label: {
+                    GlassCard(cornerRadius: GlassTokens.tileRadius) {
+                        GlassCategoryTile(
+                            title: section.title,
+                            detail: section.subtitle,
+                            symbol: section.symbol,
+                            tint: .gestaltAccent)
+                            .frame(maxWidth: .infinity, alignment: .leading)
+                    }
+                }
+                .buttonStyle(.plain)
+            }
+        }
+    }
+}
+
+/// A secondary page hosting one full diagnostics card. The card
+/// itself is unchanged; it reads the same GestaltManager and the
+/// same shared diagnostics cache as it did on the home.
+private struct HomeDiagnosticsDetailPage: View {
+    let section: HomeDiagnosticsSectionID
+
+    var body: some View {
+        ScrollView {
+            section.detailContent
+                .padding()
+        }
+        .background(GlassBackground())
+        .navigationTitle(section.title)
+        .navigationBarTitleDisplayMode(.inline)
+    }
+}
diff --git a/GestaltX/HomeSorting.swift b/GestaltX/HomeSorting.swift
new file mode 100644
index 0000000..3f1acbc
--- /dev/null
+++ b/GestaltX/HomeSorting.swift
@@ -0,0 +1,268 @@
+// SPDX-License-Identifier: GPL-3.0-only
+// Stable, testable sorting rules for the lists the home and the
+// detail pages show (P1.6). These are pure functions over the
+// existing model types: they change the ORDER of rows only, never
+// the data, the feature behavior, or which rows exist.
+//
+// Rules:
+// - Presets: the user's chosen sort, with a stable tiebreak by
+//   feature id. Apply `PresetCatalog.favoritesFirst` first when
+//   the view shows favorites first; this function only orders
+//   within the chosen sort.
+// - Restore history: newest first (date descending). Swift's
+//   `sorted(by:)` is stable, so entries with equal dates keep
+//   their input order.
+// - Modified fields: the fixed one-tap order (eSIM green-tea,
+//   eSIM not-green-tea, then the six AI capabilities in staging
+//   order); fields that are not one-tap fields sort after all of
+//   them, alphabetically by key.
+import Foundation
+
+enum HomeSorting {
+    /// The fixed one-tap order, as feature ids, from the one-tap
+    /// proposal: eSIM, region code, then the six AI capabilities in
+    /// staging order. The region code is a CacheData slot and never
+    /// appears in a Modified Values row; it is kept here so this
+    /// order is the same single source of truth as the proposal
+    /// (`SafePatchProposal.oneTap`).
+    static let oneTapFeatureOrder: [String] =
+        [FeatureEligibilityEvaluator.esimFeatureID,
+         FeatureEligibilityEvaluator.regionCodeFeatureID]
+        + ChinaUnlock.aiCapabilityIDs
+
+    /// Rank of each Modified Values row key in the one-tap order.
+    /// eSIM rows use the synthetic keys "esim-green-tea" /
+    /// "esim-not-green-tea"; AI rows use the capability's CacheExtra
+    /// key, looked up from `Capability.all`, so a key added to the
+    /// catalog is ranked without editing this file. Keys absent
+    /// from this map are not one-tap fields: they sort after all
+    /// of them, alphabetically by key.
+    static func oneTapRankByKey() -> [String: Int] {
+        var ranks: [String: Int] = [:]
+        var next = 0
+        ranks["esim-green-tea"] = next
+        next += 1
+        ranks["esim-not-green-tea"] = next
+        next += 1
+        for featureID in ChinaUnlock.aiCapabilityIDs {
+            guard let capability = Capability.all.first(where: { $0.id == featureID }) else {
+                continue
+            }
+            for key in capability.keys where ranks[key] == nil {
+                ranks[key] = next
+                next += 1
+            }
+        }
+        return ranks
+    }
+
+    /// Modified fields, by the fixed one-tap order; fields that
+    /// are not one-tap fields sort after all of them,
+    /// alphabetically by key. Rows are keyed by `key`, so equal
+    /// keys cannot occur and the result is fully deterministic.
+    static func sortModifiedValues(_ rows: [ModifiedValueRow]) -> [ModifiedValueRow] {
+        let ranks = oneTapRankByKey()
+        return rows.sorted { first, second in
+            let firstRank = ranks[first.key]
+            let secondRank = ranks[second.key]
+            switch (firstRank, secondRank) {
+            case let (a?, b?):
+                return a < b
+            case (_?, nil):
+                return true
+            case (nil, _?):
+                return false
+            case (nil, nil):
+                return first.key < second.key
+            }
+        }
+    }
+
+    /// Restore history, newest first. Swift's `sorted(by:)` is
+    /// stable, so entries with equal dates keep their input order.
+    static func sortHistory(_ entries: [RestoreTimelineEntry]) -> [RestoreTimelineEntry] {
+        entries.sorted { $0.date > $1.date }
+    }
+
+    /// The user's chosen preset sort. `.catalog` keeps the
+    /// catalog's fixed order (the input order); `.name` sorts by
+    /// Chinese name (A–Z); `.risk` sorts by risk, highest first.
+    /// Every sort breaks ties by feature id, so the result is
+    /// deterministic even when two entries share a name or a risk
+    /// level.
+    enum PresetSortOrder: String, CaseIterable, Sendable {
+        case catalog
+        case name
+        case risk
+    }
+
+    /// Presets in the user's chosen sort, with a stable tiebreak
+    /// by feature id. `.catalog` returns the input unchanged: the
+    /// catalog order is the input order.
+    ///
+    /// NOTE (Phase E decision, 2026-11-14): this function is NOT
+    /// wired into any view, deliberately. The catalog card orders
+    /// through `PersonalizationCenter.sortedEntries`, which uses
+    /// `HomeSorting.compare` — a stable sort (equal entries keep
+    /// catalog order) with `localizedStandardCompare` names. This
+    /// function instead breaks ties by feature id and compares
+    /// names with `<`, so wiring it in would change the catalog
+    /// card's visible order and fail the stable-order tests in
+    /// PersonalizationCenterTests. It stays here as a tested pure
+    /// helper; aligning the two tiebreak rules is a separate,
+    /// deliberate follow-up, not a silent swap in this phase.
+    static func sortPresets(_ entries: [PresetEntry], by order: PresetSortOrder) -> [PresetEntry] {
+        switch order {
+        case .catalog:
+            return entries
+        case .name:
+            return entries.sorted { first, second in
+                if first.chineseName != second.chineseName {
+                    return first.chineseName < second.chineseName
+                }
+                return first.featureID < second.featureID
+            }
+        case .risk:
+            return entries.sorted { first, second in
+                let firstRisk = riskRank(first.riskLevel)
+                let secondRisk = riskRank(second.riskLevel)
+                if firstRisk != secondRisk {
+                    return firstRisk < secondRisk
+                }
+                return first.featureID < second.featureID
+            }
+        }
+    }
+
+    /// Risk rank for sorting: highest risk first.
+    private static func riskRank(_ level: CapabilityRiskLevel) -> Int {
+        switch level {
+        case .high: return 0
+        case .medium: return 1
+        case .low: return 2
+        }
+    }
+
+    /// The ONE preset comparison used by every list that shows
+    /// catalog entries: `PersonalizationCenter.sortedEntries` (the
+    /// catalog card) and `sortCatalogItems` (the unified feature
+    /// catalog) both call this, so the same sort means the same
+    /// order everywhere. Semantics are the ones the catalog card
+    /// has always had and the PersonalizationCenter tests assert:
+    /// - `.byName`: Chinese name via `localizedStandardCompare`,
+    ///   then feature id via `localizedStandardCompare`.
+    /// - `.byRisk`: highest risk first; equal risk compares equal
+    ///   (the caller keeps catalog order with a stable sort).
+    /// - `.byCategory`: `PresetCategory` order; equal category
+    ///   compares equal (stable sort keeps catalog order).
+    /// This is deliberately NOT `sortPresets` above: that helper
+    /// breaks ties by feature id and compares names with `<`,
+    /// which would change the catalog card's order and fail the
+    /// stable-order tests. `sortPresets` stays as an un-wired
+    /// helper (see its note); do not wire it into a view.
+    static func compare(_ left: PresetEntry, _ right: PresetEntry, by sort: CatalogSort) -> ComparisonResult {
+        switch sort {
+        case .byName:
+            let nameComparison = left.chineseName.localizedStandardCompare(right.chineseName)
+            if nameComparison != .orderedSame { return nameComparison }
+            return left.featureID.localizedStandardCompare(right.featureID)
+        case .byRisk:
+            if left.riskLevel != right.riskLevel {
+                return riskRank(left.riskLevel) < riskRank(right.riskLevel)
+                    ? .orderedAscending : .orderedDescending
+            }
+            return .orderedSame
+        case .byCategory:
+            let leftIndex = PresetCategory.allCases.firstIndex(of: left.category) ?? PresetCategory.allCases.count
+            let rightIndex = PresetCategory.allCases.firstIndex(of: right.category) ?? PresetCategory.allCases.count
+            if leftIndex != rightIndex {
+                return leftIndex < rightIndex ? .orderedAscending : .orderedDescending
+            }
+            return .orderedSame
+        }
+    }
+
+    /// The ONE ordering rule for the unified feature catalog
+    /// (`FeatureCatalog.apply`, the catalog browser, the home
+    /// common-features section). One comparator, applied
+    /// everywhere — no per-page ad-hoc ordering. Precedence:
+    /// 1. favorites first, when the toggle is on;
+    /// 2. the user's custom order (listed ids in listed order;
+    ///    unlisted ids come after, in sort order);
+    /// 3. recent use (most recent first; recent ids before the
+    ///    rest);
+    /// 4. the user's sort: by name (`localizedStandardCompare`,
+    ///    then id), by risk (highest first; pages have no risk and
+    ///    sort as low), by category (`categorySortRank`);
+    /// 5. input order (stable: equal items keep catalog order).
+    /// With no favorites, no custom order and no recent use, the
+    /// result for preset-only input is exactly
+    /// `PersonalizationCenter.sortedEntries` — the equivalence test
+    /// in FeatureCatalogTests asserts that for all three sorts.
+    static func sortCatalogItems(
+        _ items: [FeatureCatalogItem],
+        by sort: CatalogSort,
+        favoritesFirst: Bool,
+        favoriteIDs: Set<String>,
+        customOrder: [String]?,
+        recentIDs: [String]
+    ) -> [FeatureCatalogItem] {
+        var customRank: [String: Int] = [:]
+        for (index, id) in (customOrder ?? []).enumerated() where customRank[id] == nil {
+            customRank[id] = index
+        }
+        var recentRank: [String: Int] = [:]
+        for (index, id) in recentIDs.enumerated() where recentRank[id] == nil {
+            recentRank[id] = index
+        }
+        return items.enumerated().sorted { left, right in
+            let first = left.element
+            let second = right.element
+            if favoritesFirst {
+                let firstFavorite = favoriteIDs.contains(first.id)
+                let secondFavorite = favoriteIDs.contains(second.id)
+                if firstFavorite != secondFavorite { return firstFavorite }
+            }
+            let firstCustom = customRank[first.id]
+            let secondCustom = customRank[second.id]
+            switch (firstCustom, secondCustom) {
+            case let (a?, b?):
+                if a != b { return a < b }
+            case (_?, nil):
+                return true
+            case (nil, _?):
+                return false
+            case (nil, nil):
+                break
+            }
+            let firstRecent = recentRank[first.id]
+            let secondRecent = recentRank[second.id]
+            switch (firstRecent, secondRecent) {
+            case let (a?, b?):
+                if a != b { return a < b }
+            case (_?, nil):
+                return true
+            case (nil, _?):
+                return false
+            case (nil, nil):
+                break
+            }
+            switch sort {
+            case .byName:
+                let nameComparison = first.chineseName.localizedStandardCompare(second.chineseName)
+                if nameComparison != .orderedSame { return nameComparison == .orderedAscending }
+                let idComparison = first.id.localizedStandardCompare(second.id)
+                if idComparison != .orderedSame { return idComparison == .orderedAscending }
+            case .byRisk:
+                let firstRisk = first.riskLevel.map(riskRank) ?? 2
+                let secondRisk = second.riskLevel.map(riskRank) ?? 2
+                if firstRisk != secondRisk { return firstRisk < secondRisk }
+            case .byCategory:
+                if first.categorySortRank != second.categorySortRank {
+                    return first.categorySortRank < second.categorySortRank
+                }
+            }
+            return left.offset < right.offset
+        }.map(\.element)
+    }
+}
