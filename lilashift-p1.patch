diff --git a/GestaltX/PostModificationAcceptance.swift b/GestaltX/PostModificationAcceptance.swift
new file mode 100644
index 0000000..a70f378
--- /dev/null
+++ b/GestaltX/PostModificationAcceptance.swift
@@ -0,0 +1,238 @@
+// SPDX-License-Identifier: GPL-3.0-only
+// Post-Modification Auto-Acceptance (修改后自动验收) — after the
+// user restarts the device, re-reads the device and compares each
+// modification target against what was staged, and generates a real
+// acceptance report. Pure Foundation — no SwiftUI, no UIKit, no
+// singletons, no global mutable state.
+//
+// The report distinguishes three things that must never be
+// confused:
+//   • the FILE still holding the value (the post-restart document
+//     read from the device), and
+//   • the SYSTEM actually using the value (the live probe, when
+//     the caller supplies one), and
+//   • a field that was NOT re-read: it is reported as not re-read,
+//     never claimed accepted.
+//
+// It builds on Restore Intelligence's `HistoryJournal` records and
+// the Modified Values read-only report: it does NOT duplicate
+// them — it adds the restart-aware before/after comparison and the
+// acceptance report. It never writes to the MobileGestalt cache.
+// The "mark restart-verified" action only sets a flag on history
+// records, and only for records whose items all accepted.
+import Foundation
+
+// MARK: - Outcomes
+
+/// What the post-restart re-read says about one modification.
+enum AcceptanceOutcome: String, Equatable, Sendable {
+    /// The file holds the staged target value.
+    case accepted
+    /// The file holds the original value again — the system
+    /// reverted it (the known region case: CH → LL → CH).
+    case reverted
+    /// The file holds a third value, neither the target nor the
+    /// original.
+    case changed
+    /// The field could not be read from the post-restart document
+    /// (layout unresolvable, slot unreadable, key absent).
+    case unreadable
+    /// No post-restart document was supplied, so this field was
+    /// not re-read at all.
+    case notReRead
+
+    var title: String {
+        switch self {
+        case .accepted: return L("Accepted")
+        case .reverted: return L("Reverted")
+        case .changed: return L("Changed")
+        case .unreadable: return L("Unreadable")
+        case .notReRead: return L("Not re-read")
+        }
+    }
+}
+
+/// One modification's acceptance result. `liveValue` is the live
+/// probe's answer for this key when the caller supplied one
+/// (CacheExtra keys only — CacheData slots have no live probe);
+/// `liveAgrees` is true when the live probe agrees with the staged
+/// target, false when it disagrees, `nil` when there is no live
+/// probe for this key. A file value and a live value disagreeing is
+/// reported, never hidden: the file holding a value does not mean
+/// the system uses it.
+struct AcceptanceItem: Equatable, Identifiable, Sendable {
+    /// The record this item reports on. The identity of the item:
+    /// two records may stage the same key at different times, so
+    /// the key alone is not a unique identity.
+    var id: String { recordID.uuidString }
+    let recordID: UUID
+    let key: String
+    let title: String
+    let layer: ChangeLayer
+    let original: ChangeValue
+    let target: ChangeValue
+    /// The value in the post-restart document, or `nil` when the
+    /// field was not re-read or could not be read.
+    let current: ChangeValue?
+    let outcome: AcceptanceOutcome
+    let liveValue: ChangeValue?
+    let liveAgrees: Bool?
+}
+
+/// The acceptance report for one re-read. `restartVerifiedCandidateIDs`
+/// are the record IDs whose items all accepted: the caller may mark
+/// those records restart-verified in history (a history-only flag,
+/// never a device write).
+struct AcceptanceReport: Equatable, Sendable {
+    let items: [AcceptanceItem]
+    let acceptedCount: Int
+    let revertedCount: Int
+    let changedCount: Int
+    let unreadableCount: Int
+    let notReReadCount: Int
+    let generatedAt: Date
+    /// True only when the caller confirmed the device was actually
+    /// restarted after the changes were applied. Without a restart
+    /// the file values say nothing about whether the system took
+    /// the change, and the summary says so.
+    let restartConfirmed: Bool
+    let revertedKeys: [String]
+    let restartVerifiedCandidateIDs: [UUID]
+    let summary: String
+
+    /// The disclaimer every display of this report must carry.
+    static let disclaimer = L("Only fields that were re-read after a restart are claimed accepted. A value in the file does not prove the system uses it.")
+}
+
+// MARK: - Acceptance
+
+enum PostModificationAcceptance {
+    /// Compares each recorded change against the post-restart
+    /// document. `records` are the changes this app recorded
+    /// (from `ChangeRecordStore`). `current` is the document read
+    /// after the restart, or `nil` when no post-restart read has
+    /// happened — then every item is `.notReRead` and nothing is
+    /// claimed accepted. The CacheData layout is resolved from the
+    /// post-restart document itself: a layout that cannot be
+    /// resolved there leaves CacheData items `.unreadable`, never
+    /// read through a stale layout. `liveValues` maps CacheExtra
+    /// keys to the live probe's answer, when the caller has one.
+    static func accept(
+        records: [RecordedChange],
+        current: GestaltDocument?,
+        liveValues: [String: ChangeValue] = [:],
+        restartConfirmed: Bool = false
+    ) -> AcceptanceReport {
+        let layout = current.flatMap { try? MobileGestaltCacheLayout.resolve(in: $0) }
+        var items: [AcceptanceItem] = []
+        for record in records {
+            let currentValue = current.flatMap { readCurrent(record, in: $0, using: layout) }
+            let outcome: AcceptanceOutcome
+            if current == nil {
+                outcome = .notReRead
+            } else if let currentValue {
+                if currentValue == record.new {
+                    outcome = .accepted
+                } else if currentValue == record.original {
+                    outcome = .reverted
+                } else {
+                    outcome = .changed
+                }
+            } else {
+                outcome = .unreadable
+            }
+            let liveValue = liveValues[record.key]
+            let liveAgrees = liveValue.map { $0 == record.new }
+            items.append(AcceptanceItem(
+                recordID: record.id,
+                key: record.key,
+                title: title(for: record),
+                layer: record.layer,
+                original: record.original, target: record.new,
+                current: currentValue, outcome: outcome,
+                liveValue: liveValue, liveAgrees: liveAgrees))
+        }
+        let accepted = items.filter { $0.outcome == .accepted }.count
+        let reverted = items.filter { $0.outcome == .reverted }.count
+        let changed = items.filter { $0.outcome == .changed }.count
+        let unreadable = items.filter { $0.outcome == .unreadable }.count
+        let notReRead = items.filter { $0.outcome == .notReRead }.count
+        let revertedKeys = items.filter { $0.outcome == .reverted }.map(\.key)
+        let candidateIDs = records.filter { record in
+            items.contains { $0.recordID == record.id && $0.outcome == .accepted }
+        }.map(\.id)
+        let summary: String
+        if current == nil {
+            summary = L("No post-restart document has been read. Nothing is claimed accepted.")
+        } else if !restartConfirmed {
+            summary = String(format: L("%d of %d fields hold the staged value, but the device was not confirmed restarted."), accepted, items.count)
+        } else if reverted > 0 {
+            summary = String(format: L("%d of %d fields accepted after restart; %d reverted."), accepted, items.count, reverted)
+        } else {
+            summary = String(format: L("%d of %d fields accepted after restart."), accepted, items.count)
+        }
+        return AcceptanceReport(
+            items: items, acceptedCount: accepted, revertedCount: reverted,
+            changedCount: changed, unreadableCount: unreadable, notReReadCount: notReRead,
+            generatedAt: Date(), restartConfirmed: restartConfirmed,
+            revertedKeys: revertedKeys, restartVerifiedCandidateIDs: candidateIDs,
+            summary: summary)
+    }
+
+    /// Reads the current value of one recorded change from the
+    /// post-restart document. Mirrors
+    /// `RestorePreviewBuilder.currentValue`: CacheExtra and artwork
+    /// keys read straight from the document; CacheData keys read
+    /// through `DeviceCacheOptions` with the resolved layout, and
+    /// return `nil` when the layout is unresolvable or the key is
+    /// not one of the five readable CacheData keys.
+    private static func readCurrent(
+        _ change: RecordedChange, in document: GestaltDocument,
+        using layout: MobileGestaltCacheLayout?
+    ) -> ChangeValue? {
+        switch change.layer {
+        case .cacheExtra:
+            return ChangeValue.fromPlistValue(document.extra[change.key])
+        case .artwork:
+            return ChangeValue.fromPlistValue(document.artwork[change.key])
+        case .cacheData:
+            guard let layout else { return nil }
+            switch change.key {
+            case DeviceCacheOptions.greenTeaKey:
+                return (try? DeviceCacheOptions.flags(in: document, using: layout)).map { .bool($0.greenTea) }
+            case DeviceCacheOptions.notGreenTeaKey:
+                return (try? DeviceCacheOptions.flags(in: document, using: layout)).map { .bool($0.notGreenTea) }
+            case DeviceCacheOptions.wapiKey:
+                return (try? DeviceCacheOptions.wapi(in: document, using: layout)).map(ChangeValue.bool)
+            case DeviceCacheOptions.audioIntelligenceKey, DeviceCacheOptions.personalTranslatorKey:
+                return DeviceCacheOptions.advAISlotValue(change.key, in: document, using: layout)
+                    .map(ChangeValue.bool)
+            default:
+                return nil
+            }
+        }
+    }
+
+    /// The user-facing title for a recorded change: the
+    /// capability's title when the key belongs to one, the eSIM /
+    /// region / WAPI label for the virtual features, otherwise the
+    /// key itself.
+    private static func title(for record: RecordedChange) -> String {
+        if record.layer == .cacheData && record.key == DeviceCacheOptions.greenTeaKey {
+            return L("eSIM green-tea")
+        }
+        if record.layer == .cacheData && record.key == DeviceCacheOptions.notGreenTeaKey {
+            return L("eSIM not-green-tea")
+        }
+        if record.layer == .cacheData && record.key == DeviceCacheOptions.wapiKey {
+            return L("WAPI")
+        }
+        if record.layer == .cacheExtra && record.key == GestaltKeys.regionCode {
+            return L("Region code")
+        }
+        if let capability = Capability.all.first(where: { $0.keys.contains(record.key) }) {
+            return capability.title
+        }
+        return record.key
+    }
+}
diff --git a/GestaltX/PostModificationAcceptanceViews.swift b/GestaltX/PostModificationAcceptanceViews.swift
new file mode 100644
index 0000000..2dfc2a1
--- /dev/null
+++ b/GestaltX/PostModificationAcceptanceViews.swift
@@ -0,0 +1,198 @@
+// SPDX-License-Identifier: GPL-3.0-only
+// Post-Modification Auto-Acceptance (修改后自动验收) — read-only
+// SwiftUI display.
+//
+// After the user restarts the device, compares each recorded
+// modification against the re-read document and reports, per field,
+// whether it was accepted, reverted, changed to something else, or
+// could not be read. Fields that were not re-read are never claimed
+// accepted. "Mark accepted as restart-verified" only sets a flag on
+// history records whose items all accepted — it never writes to the
+// MobileGestalt cache. The live probe is not connected yet, so
+// acceptance is based on the file value only, and the card says so.
+import SwiftUI
+
+struct PostModificationAcceptanceCard: View {
+    @EnvironmentObject private var model: GestaltManager
+    @Environment(\.colorScheme) private var colorScheme
+    @State private var records: [RecordedChange] = []
+    @State private var historyError: String?
+    @State private var restartConfirmed = false
+    @State private var saveMessage: String?
+    @State private var showingDetails = false
+
+    private var heroTint: Color {
+        colorScheme == .dark
+            ? Color(red: 0.16, green: 0.13, blue: 0.28).opacity(0.65)
+            : Color.lavenderGlass.opacity(0.65)
+    }
+
+    /// The acceptance report for the recorded changes against the
+    /// re-read document. `model.working` is the document read after
+    /// the restart; when it is `nil` every item is not re-read.
+    private var acceptanceReport: AcceptanceReport {
+        PostModificationAcceptance.accept(
+            records: records, current: model.working,
+            restartConfirmed: restartConfirmed)
+    }
+
+    var body: some View {
+        GlassCard(cornerRadius: 22, tint: heroTint) {
+            VStack(alignment: .leading, spacing: 14) {
+                HStack(spacing: 12) {
+                    GlassIconPedestal(systemImage: "checkmark.seal", tint: .gestaltAccent, size: 44)
+                    VStack(alignment: .leading, spacing: 2) {
+                        Text(L("Post-Modification Acceptance"))
+                            .font(.headline)
+                            .foregroundStyle(.primary)
+                        Text(L("Re-read the device after a restart and check what actually stuck."))
+                            .font(.subheadline)
+                            .foregroundStyle(.secondary)
+                    }
+                }
+
+                if records.isEmpty {
+                    Text(L("No modifications have been recorded yet."))
+                        .font(.subheadline)
+                        .foregroundStyle(.secondary)
+                } else {
+                    Toggle(L("I restarted the device after applying"), isOn: $restartConfirmed)
+                        .font(.subheadline)
+
+                    let report = acceptanceReport
+                    Text(report.summary)
+                        .font(.subheadline)
+                        .foregroundStyle(.secondary)
+                    HStack(spacing: 12) {
+                        Text(String(format: L("%d accepted"), report.acceptedCount))
+                            .font(.caption)
+                            .foregroundStyle(.green)
+                        Text(String(format: L("%d reverted"), report.revertedCount))
+                            .font(.caption)
+                            .foregroundStyle(.red)
+                        Text(String(format: L("%d not re-read"), report.notReReadCount))
+                            .font(.caption)
+                            .foregroundStyle(.secondary)
+                    }
+
+                    if !report.revertedKeys.isEmpty {
+                        Text(String(format: L("Reverted: %@"), report.revertedKeys.joined(separator: ", ")))
+                            .font(.caption)
+                            .foregroundStyle(.red)
+                    }
+
+                    Button(showingDetails ? L("Hide Details") : L("Show Details")) {
+                        showingDetails.toggle()
+                    }
+                    .font(.subheadline)
+
+                    if showingDetails {
+                        ForEach(report.items) { item in
+                            VStack(alignment: .leading, spacing: 2) {
+                                HStack(spacing: 8) {
+                                    Text(item.title)
+                                        .font(.subheadline)
+                                        .foregroundStyle(.primary)
+                                    Spacer()
+                                    Text(item.outcome.title)
+                                        .font(.caption.weight(.semibold))
+                                        .foregroundStyle(outcomeColor(item.outcome))
+                                }
+                                Text(String(format: L("Target %@ · Now %@"), item.target.displayText, item.current?.displayText ?? L("Unknown")))
+                                    .font(.caption)
+                                    .foregroundStyle(.secondary)
+                                if let liveAgrees = item.liveAgrees {
+                                    Text(liveAgrees ? L("Live probe agrees with the staged value.") : L("Live probe disagrees with the staged value."))
+                                        .font(.caption)
+                                        .foregroundStyle(liveAgrees ? .green : .red)
+                                }
+                            }
+                        }
+                    }
+
+                    if !report.restartVerifiedCandidateIDs.isEmpty {
+                        Button(L("Mark accepted as restart-verified")) {
+                            markRestartVerified(report.restartVerifiedCandidateIDs)
+                        }
+                        .buttonStyle(GlassPrimaryButtonStyle())
+                    }
+
+                    if let saveMessage {
+                        Text(saveMessage)
+                            .font(.caption)
+                            .foregroundStyle(.secondary)
+                    }
+                    if let historyError {
+                        Text(historyError)
+                            .font(.caption)
+                            .foregroundStyle(.red)
+                    }
+                    Text(AcceptanceReport.disclaimer)
+                        .font(.caption)
+                        .foregroundStyle(.secondary)
+                    Text(L("The live probe is not connected yet: acceptance is based on the file value only."))
+                        .font(.caption)
+                        .foregroundStyle(.secondary)
+                }
+            }
+        }
+        .onAppear { reloadHistory() }
+        .onChange(of: model.working != nil) { _, _ in reloadHistory() }
+    }
+
+    private func outcomeColor(_ outcome: AcceptanceOutcome) -> Color {
+        switch outcome {
+        case .accepted: return .green
+        case .reverted: return .red
+        case .changed: return .orange
+        case .unreadable, .notReRead: return .secondary
+        }
+    }
+
+    private func reloadHistory() {
+        guard let deviceID = RestoreIntelligence.installationDeviceID else {
+            historyError = L("History is unavailable: no installation ID has been recorded yet.")
+            records = []
+            return
+        }
+        let store = ChangeRecordStore(
+            directory: RestoreIntelligence.historyDirectory, deviceID: deviceID)
+        do {
+            records = try store.load()
+            historyError = nil
+        } catch {
+            records = []
+            historyError = L("The change history could not be read. No system changes were made.")
+        }
+    }
+
+    /// Marks the given records restart-verified in history only:
+    /// rebuilds each record with `restartVerified` set, and saves
+    /// the history file. Never writes to the MobileGestalt cache.
+    private func markRestartVerified(_ ids: [UUID]) {
+        guard let deviceID = RestoreIntelligence.installationDeviceID else {
+            historyError = L("History is unavailable: no installation ID has been recorded yet.")
+            return
+        }
+        let store = ChangeRecordStore(
+            directory: RestoreIntelligence.historyDirectory, deviceID: deviceID)
+        let updated = records.map { record in
+            RecordedChange(
+                id: record.id, date: record.date, deviceID: record.deviceID,
+                osBuild: record.osBuild, featureID: record.featureID,
+                key: record.key, layer: record.layer, original: record.original,
+                new: record.new, backupProvenance: record.backupProvenance,
+                verified: record.verified,
+                restartVerified: ids.contains(record.id) ? true : record.restartVerified)
+        }
+        do {
+            try store.save(updated)
+            records = updated
+            saveMessage = L("Accepted changes marked restart-verified in history.")
+            historyError = nil
+        } catch {
+            saveMessage = nil
+            historyError = L("The change history could not be saved. No system changes were made.")
+        }
+    }
+}
diff --git a/GestaltX/SystemHealthScore.swift b/GestaltX/SystemHealthScore.swift
new file mode 100644
index 0000000..6520973
--- /dev/null
+++ b/GestaltX/SystemHealthScore.swift
@@ -0,0 +1,355 @@
+// SPDX-License-Identifier: GPL-3.0-only
+// System Health Score (系统健康评分) — a diagnostic summary of this
+// device's cache integrity, compatibility, backup state and
+// modification risk. Pure Foundation — no SwiftUI, no UIKit, no
+// singletons, no global mutable state.
+//
+// The score is computed from REAL data only: the device profile, the
+// read snapshot, the backup inventory (with read-only verification
+// results when the caller supplies them), an optional SafePatch
+// simulation, the persisted change records, and the count of
+// modifications the Modified Values report detected outside this
+// app's records. Anything inaccessible lowers the score toward
+// "unknown" — never fabricated, never defaulted to a plausible value.
+//
+// THE SCORE IS A DIAGNOSTIC SUMMARY ONLY. It never claims a device
+// is "100% safe", "fully supported" or "guaranteed to work": a high
+// score means the checks this app can run passed, not that the
+// system will accept a change. The UI must carry that disclaimer,
+// and no score here is ever presented as a safety guarantee.
+import Foundation
+
+// MARK: - Dimensions
+
+/// One of the four scored dimensions.
+enum HealthDimension: String, CaseIterable, Equatable, Sendable {
+    case cacheIntegrity
+    case compatibility
+    case backup
+    case modificationRisk
+
+    var title: String {
+        switch self {
+        case .cacheIntegrity: return L("Cache integrity")
+        case .compatibility: return L("Compatibility")
+        case .backup: return L("Backup")
+        case .modificationRisk: return L("Modification risk")
+        }
+    }
+}
+
+/// The level a score maps to. `.unknown` means the dimension could
+/// not be scored at all (no evidence) — it is never shown as a
+/// number, and it never raises the overall score.
+enum HealthScoreLevel: String, Equatable, Sendable {
+    case healthy
+    case fair
+    case poor
+    case unknown
+
+    var title: String {
+        switch self {
+        case .healthy: return L("Healthy")
+        case .fair: return L("Fair")
+        case .poor: return L("Needs attention")
+        case .unknown: return L("Unknown")
+        }
+    }
+
+    /// Level for a 0...100 score. 80 and above is healthy, 50 and
+    /// above is fair, below 50 needs attention.
+    static func level(for score: Int) -> HealthScoreLevel {
+        if score >= 80 { return .healthy }
+        if score >= 50 { return .fair }
+        return .poor
+    }
+}
+
+/// One dimension's score: 0...100, or `nil` when it could not be
+/// scored at all. `reasons` explains every deduction in
+/// user-facing words; an unscored dimension carries the reason it
+/// could not be scored.
+struct HealthDimensionScore: Equatable, Identifiable, Sendable {
+    var id: HealthDimension { dimension }
+    let dimension: HealthDimension
+    let score: Int?
+    let level: HealthScoreLevel
+    let reasons: [String]
+}
+
+// MARK: - Result
+
+/// The full health report: four dimension scores plus an overall
+/// score (the mean of the dimensions that could be scored, or `nil`
+/// when none could be). `summary` is a short human-readable line.
+/// The disclaimer is always present: the score is diagnostic only.
+struct SystemHealthScore: Equatable, Sendable {
+    let dimensions: [HealthDimensionScore]
+    let overallScore: Int?
+    let overallLevel: HealthScoreLevel
+    let summary: String
+
+    /// The disclaimer every display of this score must carry.
+    static let disclaimer = L("This score is a diagnostic summary only. It does not guarantee safety or that any feature will work.")
+
+    func dimension(_ dimension: HealthDimension) -> HealthDimensionScore? {
+        dimensions.first { $0.dimension == dimension }
+    }
+}
+
+// MARK: - Scorer
+
+/// Pure scoring over explicit inputs. Reads its inputs, writes
+/// nothing, performs no file I/O: the caller supplies the backup
+/// verification results (from `RestoreIntelligence.verifyBackups`),
+/// the simulation (from `SafePatch.simulate`) and the recorded
+/// changes (from `ChangeRecordStore`).
+enum SystemHealthScorer {
+    /// Scores the device. `snapshot` is `nil` when the device has
+    /// never been read: then every dimension is unknown and the
+    /// overall score is `nil` — an unread device is never scored
+    /// as healthy or unhealthy.
+    static func score(
+        profile: DeviceProfile,
+        snapshot: DocumentSnapshot?,
+        backups: [BackupRecord],
+        backupVerifications: [BackupVerification] = [],
+        simulation: SafePatchSimulation? = nil,
+        recordedChanges: [RecordedChange] = [],
+        externalModificationCount: Int = 0
+    ) -> SystemHealthScore {
+        guard let snapshot else {
+            let reason = L("No document has been read.")
+            let dimensions = HealthDimension.allCases.map {
+                HealthDimensionScore(dimension: $0, score: nil, level: .unknown, reasons: [reason])
+            }
+            return SystemHealthScore(
+                dimensions: dimensions, overallScore: nil, overallLevel: .unknown,
+                summary: L("No document has been read."))
+        }
+        let cache = scoreCacheIntegrity(profile: profile, snapshot: snapshot)
+        let compatibility = scoreCompatibility(profile: profile)
+        let backup = scoreBackup(backups: backups, verifications: backupVerifications)
+        let risk = scoreModificationRisk(
+            profile: profile, simulation: simulation,
+            recordedChanges: recordedChanges,
+            externalModificationCount: externalModificationCount)
+        let dimensions = [cache, compatibility, backup, risk]
+        let scored = dimensions.compactMap(\.score)
+        // The overall score is capped at 99: no set of checks this
+        // app can run proves the system will accept a change, so no
+        // device is ever scored 100. The cap is part of the score,
+        // not a display trick — a 100 would read as a guarantee.
+        let overall: Int? = scored.isEmpty ? nil : min(scored.reduce(0, +) / scored.count, 99)
+        let level: HealthScoreLevel = overall.map(HealthScoreLevel.level(for:)) ?? .unknown
+        let summary: String
+        if let overall {
+            summary = String(format: L("Health score %d of 100. %@"), overall, level.title)
+        } else {
+            summary = L("Health could not be scored: no evidence was available.")
+        }
+        return SystemHealthScore(dimensions: dimensions, overallScore: overall,
+                                 overallLevel: level, summary: summary)
+    }
+
+    // MARK: - Cache integrity (0...100; always scored when a snapshot exists)
+
+    /// Layout resolved (40) + CacheUUID present (20) + recorded
+    /// originals present (20) + document round-trips (20). A missing
+    /// layout or a missing CacheUUID is a deduction with its reason,
+    /// never a silent default.
+    private static func scoreCacheIntegrity(
+        profile: DeviceProfile, snapshot: DocumentSnapshot
+    ) -> HealthDimensionScore {
+        var score = 0
+        var reasons: [String] = []
+        if profile.cacheLayout.isKnown {
+            score += 40
+        } else {
+            reasons.append(profile.cacheLayout.unknownReason
+                ?? L("Unable to resolve this device's MobileGestalt cache layout."))
+        }
+        switch profile.cacheReadState {
+        case .read(_, _):
+            score += 20
+        case .notRead:
+            reasons.append(L("No document has been read."))
+        case .failed(let reason):
+            reasons.append(reason)
+        }
+        let hasOriginals = !snapshot.originals.isEmpty
+            || snapshot.cachedOptionsOriginal != nil
+            || snapshot.wapiOriginal != nil
+        if hasOriginals {
+            score += 20
+        } else {
+            reasons.append(L("No recorded original exists, so a precise restore cannot be guaranteed."))
+        }
+        if roundTrips(snapshot.document) {
+            score += 20
+        } else {
+            reasons.append(L("The document could not be serialized and verified."))
+        }
+        if reasons.isEmpty {
+            reasons.append(L("Cache layout resolved, CacheUUID present, originals recorded, document verified."))
+        }
+        return HealthDimensionScore(
+            dimension: .cacheIntegrity, score: score,
+            level: HealthScoreLevel.level(for: score), reasons: reasons)
+    }
+
+    /// In-memory serialization round-trip: the document must encode
+    /// and decode back to itself. Pure, no file I/O.
+    private static func roundTrips(_ document: GestaltDocument) -> Bool {
+        guard let data = try? document.encoded(),
+              let decoded = try? GestaltDocument(data: data) else { return false }
+        return decoded.matches(document)
+    }
+
+    // MARK: - Compatibility (0...100, nil when the product type is unknown)
+
+    /// Model known (40) + OS build known (20) + OS version known
+    /// (10) + support scope recorded (30). An unknown model caps the
+    /// score at 30: a device with an unknown model must NOT score
+    /// high on compatibility. An unknown product type cannot be
+    /// scored at all.
+    private static func scoreCompatibility(profile: DeviceProfile) -> HealthDimensionScore {
+        guard profile.productType.isKnown else {
+            return HealthDimensionScore(
+                dimension: .compatibility, score: nil, level: .unknown,
+                reasons: [profile.productType.unknownReason ?? L("Device identity is unavailable.")])
+        }
+        var score = 0
+        var reasons: [String] = []
+        if profile.modelDecision.isKnown {
+            score += 40
+        } else {
+            reasons.append(profile.modelDecision.reason
+                ?? L("No US regulatory model known for this device — region code only."))
+        }
+        if profile.osBuild.isKnown {
+            score += 20
+        } else {
+            reasons.append(profile.osBuild.unknownReason ?? L("Unknown build"))
+        }
+        if profile.osVersion.isKnown {
+            score += 10
+        } else {
+            reasons.append(profile.osVersion.unknownReason ?? L("Unknown OS"))
+        }
+        if CompatibilityEntry.entry(for: profile.productType.value ?? "") != nil {
+            score += 30
+        } else {
+            reasons.append(L("No verified OS-build compatibility table exists for this model, so OS-build compatibility is unknown."))
+        }
+        // Unknown model: cap at 30, whatever the other checks say.
+        if !profile.modelDecision.isKnown {
+            score = min(score, 30)
+        }
+        if reasons.isEmpty {
+            reasons.append(L("Model, OS build and support scope are recorded for this device."))
+        }
+        return HealthDimensionScore(
+            dimension: .compatibility, score: score,
+            level: HealthScoreLevel.level(for: score), reasons: reasons)
+    }
+
+    // MARK: - Backup (0...100)
+
+    /// Any backup exists (20) + a trusted-provenance backup (50) +
+    /// a verified backup (30). No backups at all is 0. A trusted
+    /// backup that has not been verified scores 70, with the reason
+    /// saying verification is still pending — unverified is not
+    /// verified.
+    private static func scoreBackup(
+        backups: [BackupRecord], verifications: [BackupVerification]
+    ) -> HealthDimensionScore {
+        guard !backups.isEmpty else {
+            return HealthDimensionScore(
+                dimension: .backup, score: 0, level: .poor,
+                reasons: [L("No backups exist yet.")])
+        }
+        var score = 20
+        var reasons: [String] = []
+        if backups.contains(where: { $0.provenance.isTrustedForRestore }) {
+            score += 50
+        } else {
+            reasons.append(L("No trusted backup exists yet."))
+        }
+        let verifiedCount = verifications.filter {
+            if case .verified = $0.status { return true }
+            return false
+        }.count
+        if verifiedCount > 0 {
+            score += 30
+        } else if verifications.isEmpty {
+            reasons.append(L("Backups have not been verified yet."))
+        } else {
+            reasons.append(L("The backup could not be verified. No system changes were made."))
+        }
+        if reasons.isEmpty {
+            reasons.append(L("A trusted, verified backup exists for restore."))
+        }
+        return HealthDimensionScore(
+            dimension: .backup, score: score,
+            level: HealthScoreLevel.level(for: score), reasons: reasons)
+    }
+
+    // MARK: - Modification risk (0...100, higher is safer)
+
+    /// Starts at 100 and deducts: staged diffs (1–9: −10, 10+:
+    /// −20), hardware-identity touches (score 0), a failed
+    /// native/conflict check (−20), an unresolvable eSIM layout
+    /// (−20), modifications detected outside this app's records
+    /// (−10), recorded changes not verified as restored (−5 each,
+    /// at most −15). The floor is 0.
+    private static func scoreModificationRisk(
+        profile: DeviceProfile,
+        simulation: SafePatchSimulation?,
+        recordedChanges: [RecordedChange],
+        externalModificationCount: Int
+    ) -> HealthDimensionScore {
+        var score = 100
+        var reasons: [String] = []
+        if let simulation {
+            switch simulation.diffs.count {
+            case 0:
+                break
+            case 1...9:
+                score -= 10
+                reasons.append(String(format: L("Would change %d fields"), simulation.diffs.count))
+            default:
+                score -= 20
+                reasons.append(String(format: L("Would change %d fields"), simulation.diffs.count))
+            }
+            if !simulation.hardwareIdentityTouches.isEmpty {
+                score = 0
+                reasons.append(L("This proposal touches a hardware-identity field. Staging it is refused."))
+            }
+            if let nativeCheck = simulation.check(.nativeAndConflicts), !nativeCheck.passed {
+                score -= 20
+                reasons.append(nativeCheck.reason)
+            }
+        }
+        if !profile.cacheLayout.isKnown {
+            score -= 20
+            reasons.append(L("Unable to resolve this device's MobileGestalt cache layout."))
+        }
+        if externalModificationCount > 0 {
+            score -= 10
+            reasons.append(String(format: L("%d fields were modified outside this app's records."), externalModificationCount))
+        }
+        if !recordedChanges.isEmpty {
+            let deduction = min(recordedChanges.count * 5, 15)
+            score -= deduction
+            reasons.append(String(format: L("%d recorded modifications have not been verified as restored."), recordedChanges.count))
+        }
+        score = max(score, 0)
+        if reasons.isEmpty {
+            reasons.append(L("No modifications recorded."))
+        }
+        return HealthDimensionScore(
+            dimension: .modificationRisk, score: score,
+            level: HealthScoreLevel.level(for: score), reasons: reasons)
+    }
+}
diff --git a/GestaltX/SystemHealthScoreViews.swift b/GestaltX/SystemHealthScoreViews.swift
new file mode 100644
index 0000000..daaa38b
--- /dev/null
+++ b/GestaltX/SystemHealthScoreViews.swift
@@ -0,0 +1,170 @@
+// SPDX-License-Identifier: GPL-3.0-only
+// System Health Score (系统健康评分) — read-only SwiftUI display.
+//
+// Shows the overall score and the four dimension scores, each with
+// its reasons. The card always carries the disclaimer: the score is
+// a diagnostic summary only, never a guarantee of safety or that a
+// feature will work. It never writes anything: the score is computed
+// from the current snapshot, the backup inventory (with read-only
+// verification), a one-tap SafePatch simulation, the persisted
+// change records and the Modified Values report.
+import SwiftUI
+
+struct SystemHealthScoreCard: View {
+    @EnvironmentObject private var model: GestaltManager
+    @Environment(\.colorScheme) private var colorScheme
+    @State private var records: [RecordedChange] = []
+    @State private var historyError: String?
+    @State private var showingDetails = false
+
+    private var heroTint: Color {
+        colorScheme == .dark
+            ? Color(red: 0.16, green: 0.13, blue: 0.28).opacity(0.65)
+            : Color.lavenderGlass.opacity(0.65)
+    }
+
+    /// The report for the current snapshot, or `nil` when the device
+    /// has not been read yet.
+    private var healthScore: SystemHealthScore? {
+        guard model.snapshot != nil else { return nil }
+        let report = LilaIntelligence.report(
+            snapshot: model.snapshot, backups: model.backups,
+            changeRecordCount: records.count)
+        let verifications = RestoreIntelligence.verifyBackups(model.backups, against: model.working)
+        let simulation = SafePatch.simulate(
+            proposal: SafePatchProposal.oneTap(), snapshot: model.snapshot,
+            currentDocument: model.working, backups: model.backups)
+        return SystemHealthScorer.score(
+            profile: report.profile, snapshot: model.snapshot,
+            backups: model.backups, backupVerifications: verifications,
+            simulation: simulation, recordedChanges: records,
+            externalModificationCount: externalModificationCount)
+    }
+
+    /// Fields the Modified Values report found changed, minus the
+    /// keys this app recorded: what remains was modified outside
+    /// this app's records. The match is by key string (rows carry
+    /// no layer); the known keys do not collide across layers.
+    private var externalModificationCount: Int {
+        let recordedKeys = Set(records.map(\.key))
+        return ModifiedValues.report(for: model.snapshot).rows
+            .filter { !recordedKeys.contains($0.key) }.count
+    }
+
+    var body: some View {
+        GlassCard(cornerRadius: 22, tint: heroTint) {
+            VStack(alignment: .leading, spacing: 14) {
+                HStack(spacing: 12) {
+                    GlassIconPedestal(systemImage: "heart.text.square", tint: .gestaltAccent, size: 44)
+                    VStack(alignment: .leading, spacing: 2) {
+                        Text(L("System Health Score"))
+                            .font(.headline)
+                            .foregroundStyle(.primary)
+                        Text(L("Cache, compatibility, backup and modification risk, from real readings only."))
+                            .font(.subheadline)
+                            .foregroundStyle(.secondary)
+                    }
+                }
+
+                if model.snapshot == nil {
+                    Text(L("Read the device first to score its health."))
+                        .font(.subheadline)
+                        .foregroundStyle(.secondary)
+                    Button(L(model.isBusy ? "Reading…" : "Read Device")) {
+                        Task { await model.connect() }
+                    }
+                    .buttonStyle(GlassPrimaryButtonStyle())
+                    .disabled(model.isBusy)
+                    .opacity(model.isBusy ? 0.5 : 1)
+                } else if let healthScore {
+                    HStack(alignment: .firstTextBaseline, spacing: 8) {
+                        if let overall = healthScore.overallScore {
+                            Text("\(overall)")
+                                .font(.system(size: 44, weight: .bold, design: .rounded))
+                                .foregroundStyle(.primary)
+                            Text("/ 100 · \(healthScore.overallLevel.title)")
+                                .font(.headline)
+                                .foregroundStyle(.secondary)
+                        } else {
+                            Text(L("Unknown"))
+                                .font(.title2)
+                                .foregroundStyle(.secondary)
+                        }
+                    }
+                    Text(healthScore.summary)
+                        .font(.subheadline)
+                        .foregroundStyle(.secondary)
+
+                    ForEach(healthScore.dimensions) { dimension in
+                        HStack(spacing: 8) {
+                            Text(dimension.dimension.title)
+                                .font(.subheadline)
+                                .foregroundStyle(.primary)
+                            Spacer()
+                            if let score = dimension.score {
+                                Text("\(score)")
+                                    .font(.subheadline)
+                                    .foregroundStyle(.primary)
+                                Text("· \(dimension.level.title)")
+                                    .font(.caption)
+                                    .foregroundStyle(.secondary)
+                            } else {
+                                Text(L("Unknown"))
+                                    .font(.subheadline)
+                                    .foregroundStyle(.secondary)
+                            }
+                        }
+                    }
+
+                    Button(showingDetails ? L("Hide Details") : L("Show Details")) {
+                        showingDetails.toggle()
+                    }
+                    .font(.subheadline)
+
+                    if showingDetails {
+                        ForEach(healthScore.dimensions) { dimension in
+                            VStack(alignment: .leading, spacing: 4) {
+                                Text(dimension.dimension.title)
+                                    .font(.subheadline)
+                                    .foregroundStyle(.primary)
+                                ForEach(Array(dimension.reasons.enumerated()), id: \.offset) { _, reason in
+                                    Text("• \(reason)")
+                                        .font(.caption)
+                                        .foregroundStyle(.secondary)
+                                }
+                            }
+                        }
+                    }
+
+                    if let historyError {
+                        Text(historyError)
+                            .font(.caption)
+                            .foregroundStyle(.secondary)
+                    }
+                    Text(SystemHealthScore.disclaimer)
+                        .font(.caption)
+                        .foregroundStyle(.secondary)
+                }
+            }
+        }
+        .onAppear { reloadHistory() }
+        .onChange(of: model.working != nil) { _, _ in reloadHistory() }
+    }
+
+    private func reloadHistory() {
+        guard let deviceID = RestoreIntelligence.installationDeviceID else {
+            historyError = L("History is unavailable: no installation ID has been recorded yet.")
+            records = []
+            return
+        }
+        let store = ChangeRecordStore(
+            directory: RestoreIntelligence.historyDirectory, deviceID: deviceID)
+        do {
+            records = try store.load()
+            historyError = nil
+        } catch {
+            records = []
+            historyError = L("The change history could not be read. No system changes were made.")
+        }
+    }
+}
