diff --git a/GestaltX/ReleaseNotes.swift b/GestaltX/ReleaseNotes.swift
new file mode 100644
index 0000000..777358a
--- /dev/null
+++ b/GestaltX/ReleaseNotes.swift
@@ -0,0 +1,125 @@
+// SPDX-License-Identifier: GPL-3.0-only
+// Release notes + version validation (发布说明与版本校验) — pure
+// Foundation, no UI, no device access, no writes to the MobileGestalt
+// cache. The release tooling (`scripts/prepare-release.py`) mirrors
+// this logic in Python; the Swift module is the testable definition
+// and the Python script is the operational tool. Both agree: a
+// marketing version is `X.Y.Z`, a build number is a positive
+// integer, and the notes are Markdown grouped by section.
+import Foundation
+
+/// A release version: a marketing version (`X.Y.Z`) and an integer
+/// build number. Both are validated on parse; an invalid value
+/// produces `nil` instead of a guessed version.
+struct ReleaseVersion: Equatable, Sendable {
+    let marketing: String
+    let build: Int
+
+    /// Parses `marketing` and `build`. The marketing version must be
+    /// exactly three dot-separated parts, each a non-negative integer
+    /// without leading zeros (unless the part is exactly "0"). The
+    /// build must be a positive integer without leading zeros.
+    /// Returns `nil` for anything else — never a guessed version.
+    static func parse(marketing: String, build: String) -> ReleaseVersion? {
+        guard isValidMarketing(marketing), let buildValue = validBuild(build) else {
+            return nil
+        }
+        return ReleaseVersion(marketing: marketing, build: buildValue)
+    }
+
+    /// Whether `value` is a valid marketing version (`X.Y.Z`).
+    static func isValidMarketing(_ value: String) -> Bool {
+        let parts = value.split(separator: ".", omittingEmptySubsequences: false)
+        guard parts.count == 3 else { return false }
+        return parts.allSatisfy { isPlainInteger(String($0)) }
+    }
+
+    /// Whether `value` is a valid build number (a positive integer).
+    static func isValidBuild(_ value: String) -> Bool {
+        validBuild(value) != nil
+    }
+
+    /// The next build number for the same marketing version.
+    func nextBuild() -> ReleaseVersion {
+        ReleaseVersion(marketing: marketing, build: build + 1)
+    }
+
+    /// A non-negative integer without leading zeros (unless the
+    /// value is exactly "0"). Used for the marketing-version parts.
+    private static func isPlainInteger(_ value: String) -> Bool {
+        guard !value.isEmpty, value.allSatisfy({ $0.isNumber }) else { return false }
+        if value.count > 1 && value.hasPrefix("0") { return false }
+        return true
+    }
+
+    /// The build number as an integer, or `nil` when `value` is not
+    /// a positive integer without leading zeros. `Int` conversion
+    /// returns `nil` on overflow, so an over-long digit string is
+    /// rejected rather than wrapped.
+    private static func validBuild(_ value: String) -> Int? {
+        guard !value.isEmpty, value.allSatisfy({ $0.isNumber }) else { return nil }
+        if value.count > 1 && value.hasPrefix("0") { return nil }
+        guard let parsed = Int(value), parsed > 0 else { return nil }
+        return parsed
+    }
+}
+
+/// One entry in the release notes: a PR (or a manual item) with a
+/// section. `number` is `nil` for a manual item (no PR to link).
+struct ReleaseNoteEntry: Equatable, Sendable {
+    enum Section: String, CaseIterable, Sendable {
+        case added
+        case changed
+        case fixed
+
+        var heading: String {
+            switch self {
+            case .added: return "Added"
+            case .changed: return "Changed"
+            case .fixed: return "Fixed"
+            }
+        }
+    }
+
+    let number: Int?
+    let title: String
+    let section: Section
+}
+
+/// Renders release notes as Markdown. Sections appear in
+/// Added/Changed/Fixed order and are omitted when empty. Entries
+/// keep the order they were given. A `notes` string (human-editable,
+/// for example known limitations) is appended as a final "Notes"
+/// section when it is non-empty after trimming.
+enum ReleaseNotes {
+    static func render(
+        version: ReleaseVersion, entries: [ReleaseNoteEntry], notes: String? = nil
+    ) -> String {
+        var lines: [String] = []
+        lines.append("## LilaShift \(version.marketing) (Build \(version.build))")
+        lines.append("")
+        for section in ReleaseNoteEntry.Section.allCases {
+            let sectionEntries = entries.filter { $0.section == section }
+            guard !sectionEntries.isEmpty else { continue }
+            lines.append("### \(section.heading)")
+            lines.append("")
+            for entry in sectionEntries {
+                if let number = entry.number {
+                    lines.append("- \(entry.title) (#\(number))")
+                } else {
+                    lines.append("- \(entry.title)")
+                }
+            }
+            lines.append("")
+        }
+        if let notes = notes?.trimmingCharacters(in: .whitespacesAndNewlines),
+           !notes.isEmpty {
+            lines.append("### Notes")
+            lines.append("")
+            lines.append(notes)
+            lines.append("")
+        }
+        while lines.last == "" { lines.removeLast() }
+        return lines.joined(separator: "\n") + "\n"
+    }
+}
diff --git a/docs/SNAPSHOT_TESTING.md b/docs/SNAPSHOT_TESTING.md
new file mode 100644
index 0000000..d51a5b1
--- /dev/null
+++ b/docs/SNAPSHOT_TESTING.md
@@ -0,0 +1,103 @@
+# Snapshot Testing (UI 回归测试)
+
+The key SwiftUI cards are covered by snapshot tests
+(`tests/ViewSnapshotTests.swift`) using
+[SnapshotTesting](https://github.com/pointfreeco/swift-snapshot-testing)
+1.19.7 (exact pin, test target only). There is no XCUITest target —
+SnapshotTesting in the existing unit-test target is the right scope:
+it needs a simulator, not a device, and it runs inside the existing
+`xcodebuild test` invocation.
+
+## What is snapshotted
+
+| Card | States | Strategy |
+| --- | --- | --- |
+| Preset catalog card | unread / populated | image |
+| Smart fault diagnosis card | unread / populated | image |
+| Personalization center card | unread / populated | image |
+| System health score card | unread / populated | image |
+| Diagnostics inputs | battery unknown / known, connection not-read / read, cache entries | `.dump` (text) |
+
+Image snapshots use a fixed 390×844 layout, light traits, display
+scale 2, `precision: 1`, `perceptualPrecision: 0.98`. The
+"populated" state uses the fixed `CoreModuleFixtures` snapshot
+(iPhone18,1 / Air A3518, region LL, AI on, eSIM on, originals region
+CH with the AI keys absent) — no live device read, no clock, no
+network. The "unread" state uses a fresh `GestaltManager` with no
+snapshot, so every card renders its "read the device first" empty
+state.
+
+## Why the DiagnosticsExpansionCard has no image snapshot
+
+Its cache section renders the live sizes of the app container
+(Application Support / Caches / Temporary), including the temporary
+directory where other tests write files. Those numbers depend on
+test execution order, so a pixel snapshot of that card would be
+flaky. The card's deterministic inputs are snapshotted as text
+instead (`.dump` of `BatteryStatus`, `DeviceConnectionStatus`, and
+the `AppContainerCacheEntry` list measured from a fixed temporary
+directory). Only the entries are dumped, not the whole report: the
+report carries a `measuredAt` clock value that would make the
+snapshot non-deterministic. This is a deliberate, documented gap —
+not an oversight.
+
+## Where the references live
+
+```
+tests/__Snapshots__/ViewSnapshotTests/
+  testPresetCatalogCardUnreadSnapshot.preset-catalog-unread.png
+  testPresetCatalogCardPopulatedSnapshot.preset-catalog-populated.png
+  ... (8 .png files, one per image test)
+  testDiagnosticsBatteryUnknownSnapshot.battery-unknown.txt
+  ... (5 .txt files, one per dump test)
+```
+
+The file name is `<test function name>.<snapshot name>.<png|txt>`.
+
+## How references are created (first run)
+
+The tests pass `record: .missing`, which means only missing
+references are recorded — an existing reference is compared and
+never overwritten. So:
+
+1. The **first CI run records** the references and passes. The Run
+   Swift Tests workflow uploads `tests/__Snapshots__/` as an
+   artifact (see below).
+2. **Download the artifact** and commit the recorded files to the
+   branch. Until they are committed, the tests record but do not yet
+   guard against regressions — say so in any report that mentions
+   these tests.
+3. From the second run on, the tests compare against the committed
+   references and fail on any pixel/text difference.
+
+There is no way to generate the references on the coordinator VM
+(no Swift compiler, no simulator), so the first CI run is the
+recording step. Never commit a reference that was not generated by
+a real run, and never edit a reference image by hand.
+
+## When a snapshot legitimately changes
+
+A UI change that is intended will make the snapshot test fail.
+To update the reference:
+
+1. Delete the reference file (`tests/__Snapshots__/ViewSnapshotTests/<file>`).
+2. Re-run the test (locally or in CI). With `record: .missing` it
+   records the new reference and passes.
+3. Commit the new reference file. Review the recorded image (it is
+   in the CI artifact) before committing — a re-record can hide a
+   real regression if it is done blindly.
+
+Alternatively, run once with the environment variable
+`SNAPSHOT_TESTING_RECORD=all`, which re-records every reference.
+Prefer deleting the single file: it makes the change reviewable.
+
+## Debugging a failure
+
+A failing snapshot test attaches the diff image to the test result
+(SnapshotTesting writes a failure diff next to the reference).
+Compare the recorded reference with the new image: if the change
+is a layout shift, a font change, or a simulator-version rendering
+difference, decide whether it is legitimate (re-record) or a real
+regression (fix the code). Pixel snapshots are sensitive to the
+simulator and Xcode version — if CI moves to a new Xcode, expect
+to re-record and review the images.
